;;; la-z2-action.scm -- linear algebra 3.43: the invertible matrices act freely and
;;; transitively on the free generating sequences (LA-Z2, 2026-10-23).
;;;
;;; Setting (as in mod-seq.scm and mod-basis-proof.scm): a MODULE md over a ring
;;; SCAL(md); a sequence of n vectors is a column xs in MAT(n, 1, VEC md); a matrix pm
;;; acts by MATACT.  The notes' E is a free abelian group and the matrices are integral;
;;; that is the instance SCAL(md) = ZZ-RING (the abelian-group-as-ZZ-module view does
;;; not exist in the tree, see the table row 3.40).
;;;
;;; PLAN.
;;;  * Row read-off.  For P in MAT(m,n), the i-th row of P is unitrow_i P
;;;    (unitrow-matmul-entry), and its combination with xs is the i-th entry of P.xs
;;;    (row-matact-lincomb: matact-lincomb + matact-assoc + lincomb-unitrow).
;;;  * Cancellation.  On a relation-free xs, c.xs = d.xs forces c = d
;;;    (rel-free-lincomb-cancel: c + (-1) d annihilates xs), hence P.xs = Q.xs forces
;;;    P = Q (rel-free-matact-cancel, row by row).
;;;  * Coefficients against a spanning sequence of a submodule: spans-coeff-matrix, the
;;;    SPANS twin of generates-coeff-matrix (rake-generates-coeff.scm, whose proof this
;;;    one follows).
;;;  * Transitivity (the notes' "immediate consequence of the definition"): ys = A.xs
;;;    and xs = B.ys, so (BA).xs = xs = I.xs and (AB).ys = ys = I.ys; cancellation gives
;;;    BA = I = AB, so A is invertible (inverse-is-invertible).  Proven for two
;;;    relation-free sequences spanning the same submodule (spans-rel-free-transitive),
;;;    which 3.45 and 3.48 need; 3.43 is the case sm = VEC md.
;;;  * Freeness: P.xs = Q.xs with xs relation-free gives P = Q.
;;;
;;; LOAD WINDOW / LIBRARY: see the LA-Z2 report.  Destination theorem-library/.
;;; Library: linear-algebra.  Prefix lza-.

(define (lza-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z2-action: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))

;; detach every antecedent of the chain INST: one the context holds is detached, any
;; other is proved on a lane by `prop' (size guards) -- la-z-gcd's lzg-detach-all!
(define (lza-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lza-cite! thm . args) (lza-detach-all! (apply dk-cite! thm args)))

;; open a definition (def-predicate IFF) of HYP in context, HYP surviving: land the
;; right-hand side, split its conjunctions, return the parts
(define (lza-open! name . args)
  (let* ((hyp (cons name args))
         (ignore (apply fact name args))
         (iff (iff-for hyp))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let loop ((todo (list (dk-ctx-form rhs))) (acc '()))
      (cond ((null? todo) (reverse acc))
            ((dk-head-is? (car todo) 'AND) (loop (append (dk-split! (car todo)) (cdr todo)) acc))
            (#t (loop (cdr todo) (cons (car todo) acc)))))))

(define LZA-S '(SCAL md))
(define LZA-CS '(CARR (SCAL md)))
(define (lza-mm a b) (list 'MATMUL LZA-S a b))
(define (lza-ma a b) (list 'MATACT 'md a b))

;;; =====================================================================
;;; (0) A ring fact: a + (-b) = 0 => a = b.
;;; =====================================================================
(sp (make-wff (forall-guarded '(s ra rb) '((IS-RING s) (IN ra (CARR s)) (IN rb (CARR s))
                                           (= ((ADD s) ra ((NEG s) rb)) (ZERO s)))
                '(= ra rb))))
(dk-peel!)
(fact 'ring-neg-in-carr 's 'rb)
(dk-cite! 'ring-add-inverse-unique 's 'ra '((NEG s) rb))
(fact 'ring-neg-neg 's 'rb)
(fact 'ring-neg-neg 's 'ra)
(subst '(= rb ((NEG s) ((NEG s) rb))))
(subst '(= ((NEG s) rb) ((NEG s) ra)))
(subst '(= ((NEG s) ((NEG s) ra)) ra))
(rfl)
(lza-done! 'lza-ring-sub-zero)
(topic! 'lza-ring-sub-zero 'plumbing)

(define LZA-N1 '((NEG (SCAL md)) (ONE (SCAL md))))
;;; =====================================================================
;;; (0b) A module fact: x + (-1) x = 0 (frm-v-right-inv loads only at frechet-metric).
;;; =====================================================================
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(x) '((IN x (VEC md)))
    (list '= (list '(VADD md) 'x (list '(ACT md) LZA-N1 'x)) '(VZERO md))))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'ring-one-in LZA-S)
(fact 'ring-neg-in-carr LZA-S '(ONE (SCAL md)))
(let* ((one '(ONE (SCAL md)))
       (h (dk-cite! 'module-act-distrib-scalar 'md one LZA-N1 'x))
       (u (dk-cite! 'module-act-unital 'md 'x))
       (h1 (dk-rewrite-h! h (list '(ACT md) one 'x) 'x))
       (r (dk-cite! 'ring-add-right-inv LZA-S one))
       (h2 (dk-rewrite-h! h1 (list '(ADD (SCAL md)) one LZA-N1) '(ZERO (SCAL md))))
       (z (dk-cite! 'module-zero-act 'md 'x))
       (h3 (dk-rewrite-h! h2 (list '(ACT md) '(ZERO (SCAL md)) 'x) '(VZERO md))))
  (subst (list '= (caddr h3) (cadr h3)))
  (fact 'module-vzero-in 'md)
  (rfl))
(lza-done! 'lza-vadd-neg-one)
(topic! 'lza-vadd-neg-one 'plumbing)

;;; =====================================================================
;;; (1) The i-th row of P is unitrow_i P.
;;; =====================================================================
(define LZA-UR '(UNITROW a m ri))
(sp (make-wff (forall-guarded '(a m n pm ri cj)
                '((IS-RING a) (IN pm (MAT m n (CARR a))) (IN ri (INTERVAL 1 m)) (IN cj (INTERVAL 1 n)))
                (list '= (list 'ENTRY (list 'MATMUL 'a LZA-UR 'pm) 1 'cj) '(ENTRY pm ri cj)))))
(dk-peel!)
(fact 'mat-rows-in-nn 'm 'n '(CARR a) 'pm)
(dk-one-le-from! 'ri 'm)
(fact 'unitrow-type 'a 'm 'ri)
(fact 'one-in-interval-1)
(let* ((fs (list 'VNB-LAMBDA 'j '(INTERVAL 1 m) (list '(MUL a) (list 'ENTRY LZA-UR 1 'j) '(ENTRY pm j cj))))
       (rag '(RING-ADDITIVE-AG a))
       (van (list 'FORALL 'jz (list 'IMPLIES '(IN jz (INTERVAL 1 m))
              (list 'IMPLIES '(NOT (= jz ri)) (list '= (list fs 'jz) (list 'IDEN rag)))))))
  (subst (dk-cite! 'matmul-entry 'a 1 'm 'n LZA-UR 'pm 1 'cj))
  (fact 'matprod-summand-type 'a 1 'm 'n LZA-UR 'pm 1 'cj)
  (fact 'ring-additive-ag-is-abelian-group 'a)
  (fact 'interval-in-set 1 'm)
  (fact 'interval-card-in-nn 1 'm)
  (fact 'ras-id 'a)
  (dk-have! van
    (lambda ()
      (let* ((ld (dk-peel!))
             (jz (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 m)))) ld))))
        (lam-b)
        (subst (dk-cite! 'unitrow-entry-off 'a 'm 'ri jz))
        (fact 'entry-in-carrier 'm 'n '(CARR a) 'pm jz 'cj)
        (subst (dk-cite! 'ring-mul-zero-left 'a (list 'ENTRY 'pm jz 'cj)))
        (subst (list '= (list 'IDEN rag) '(ZERO a)))
        (rfl))))
  (subst (dk-cite! 'finsum-single-support rag '(INTERVAL 1 m) fs 'ri))
  (lam-b)
  (subst (dk-cite! 'unitrow-entry-at 'a 'm 'ri))
  (fact 'entry-in-carrier 'm 'n '(CARR a) 'pm 'ri 'cj)
  (subst (dk-cite! 'ring-mul-left-id 'a '(ENTRY pm ri cj)))
  (rfl))
(lza-done! 'unitrow-matmul-entry)
(topic! 'unitrow-matmul-entry 'algebra)
(gloss! 'unitrow-matmul-entry "The product of the i-th unit row with a matrix P is the i-th row of P.")

;;; =====================================================================
;;; (2) The combination of xs with the i-th row of P is the i-th entry of P.xs.
;;; =====================================================================
(define LZA-URS '(UNITROW (SCAL md) m ri))
(define LZA-RP (lza-mm LZA-URS 'pm))
(define LZA-MPX (lza-ma 'pm 'xs))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(m n pm xs ri)
    (list (list 'IN 'pm (list 'MAT 'm 'n LZA-CS)) '(IN xs (MAT n 1 (VEC md))) '(IN ri (INTERVAL 1 m)) '(<= 1 n))
    (list '= (list 'LINCOMB 'md 'n LZA-RP 'xs) (list 'ENTRY LZA-MPX 'ri 1))))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'mat-rows-in-nn 'm 'n LZA-CS 'pm)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(dk-one-le-from! 'ri 'm)
(dk-nonzero! 'm)
(dk-nonzero! 'n)
(fact 'one-in-interval-1)
(fact 'unitrow-type LZA-S 'm 'ri)
(lza-cite! 'matmul-type LZA-S 1 'm 'n LZA-URS 'pm)
(lza-cite! 'matact-type 'md 'm 'n 1 'pm 'xs)
(let* ((e1 (lza-cite! 'matact-lincomb 'md 'n LZA-RP 'xs))
       (e2 (lza-cite! 'matact-assoc 'md 1 'm 'n 1 LZA-URS 'pm 'xs))
       (e3 (lza-cite! 'matact-lincomb 'md 'm LZA-URS LZA-MPX))
       (e4 (lza-cite! 'lincomb-unitrow 'md 'm 'ri LZA-MPX)))
  (subst (list '= (caddr e1) (cadr e1)))
  (subst e2)
  (subst e3)
  (subst e4)
  (fact 'entry-in-carrier 'm 1 '(VEC md) LZA-MPX 'ri 1)
  (rfl))
(lza-done! 'row-matact-lincomb)
(topic! 'row-matact-lincomb 'algebra)
(gloss! 'row-matact-lincomb "The combination of a sequence with the i-th row of P is the i-th entry of P acting on the sequence.")

;;; =====================================================================
;;; (3) On a relation-free sequence, equal combinations have equal coefficients.
;;; =====================================================================
(define LZA-MS (list 'MATSCALE LZA-S LZA-N1 'dr))
(define LZA-E (list 'MATADD LZA-S 'cr LZA-MS))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(n cr dr xs)
    (list (list 'IN 'cr (list 'MAT 1 'n LZA-CS)) (list 'IN 'dr (list 'MAT 1 'n LZA-CS))
          '(IN xs (MAT n 1 (VEC md))) '(REL-FREE md n xs)
          '(= (LINCOMB md n cr xs) (LINCOMB md n dr xs)))
    '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (= (ENTRY cr 1 j_) (ENTRY dr 1 j_))))))))
(let* ((ld (dk-peel!))
       (jv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'INTERVAL))) ld)))
       (lc '(LINCOMB md n cr xs))
       (ldr '(LINCOMB md n dr xs)))
  (fact 'module-scalar-ring 'md)
  (fact 'ring-one-in LZA-S)
  (fact 'ring-neg-in-carr LZA-S '(ONE (SCAL md)))
  (fact 'matscale-type LZA-S 1 'n LZA-N1 'dr)
  (fact 'matadd-type LZA-S 1 'n 'cr LZA-MS)
  (fact 'lincomb-type 'md 'n 'dr 'xs)
  (let* ((ea (dk-cite! 'lincomb-row-add 'md 'n 'cr LZA-MS 'xs))
         (es (dk-cite! 'lincomb-row-scale 'md 'n LZA-N1 'dr 'xs))
         (ei (dk-cite! 'lza-vadd-neg-one 'md ldr))
         (z (list '= (list 'LINCOMB 'md 'n LZA-E 'xs) '(VZERO md))))
    (dk-have! z
      (lambda ()
        (subst ea) (subst es)
        (subst (list '= lc ldr))
        (subst ei)
        (rfl)))
    (let* ((rf (dk-landed-1 (lambda () (mac-h 'REL-FREE '(REL-FREE md n xs)))))
           (allj (dk-apply! rf LZA-E))
           (z0 (dk-apply! allj jv))
           (cj (list 'ENTRY 'cr 1 jv))
           (dj (list 'ENTRY 'dr 1 jv)))
      (fact 'one-in-interval-1)
      (fact 'entry-in-carrier 1 'n LZA-CS 'cr 1 jv)
      (fact 'entry-in-carrier 1 'n LZA-CS 'dr 1 jv)
      (let* ((ms-j (list 'ENTRY LZA-MS 1 jv))
             (mul1 (list '(MUL (SCAL md)) LZA-N1 dj))
             (one1 (list '(MUL (SCAL md)) '(ONE (SCAL md)) dj))
             (ignore (begin
                       (fact 'matadd-entry LZA-S 1 'n 'cr LZA-MS 1 jv)
                       (fact 'matscale-entry LZA-S 1 'n LZA-N1 'dr 1 jv)
                       (fact 'ring-neg-mul-left LZA-S '(ONE (SCAL md)) dj)
                       (fact 'ring-mul-left-id LZA-S dj)))
             (h1 (dk-rewrite-h! z0 (list 'ENTRY LZA-E 1 jv) (list '(ADD (SCAL md)) cj ms-j)))
             (h2 (dk-rewrite-h! h1 ms-j mul1))
             (h3 (dk-rewrite-h! h2 mul1 (list '(NEG (SCAL md)) one1)))
             (h4 (dk-rewrite-h! h3 one1 dj)))
        (dk-cite! 'lza-ring-sub-zero LZA-S cj dj)
        (ass)))))
(lza-done! 'rel-free-lincomb-cancel)
(topic! 'rel-free-lincomb-cancel 'algebra)
(gloss! 'rel-free-lincomb-cancel "Two coefficient rows giving the same combination of a relation-free sequence are equal.")

;;; =====================================================================
;;; (4) On a relation-free sequence, P.xs = Q.xs forces P = Q.
;;; =====================================================================
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(m n xs pm qm)
    (list '(IN xs (MAT n 1 (VEC md))) (list 'IN 'pm (list 'MAT 'm 'n LZA-CS)) (list 'IN 'qm (list 'MAT 'm 'n LZA-CS))
          '(REL-FREE md n xs) (list '= (lza-ma 'pm 'xs) (lza-ma 'qm 'xs)))
    '(= pm qm)))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'mat-rows-in-nn 'm 'n LZA-CS 'pm)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(detach-with! (dk-cite! 'matrix-entry-extensionality 'm 'n LZA-CS 'pm 'qm)
  (lambda ()
    (let* ((ld (dk-peel!))
           (iv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 m)))) ld)))
           (jv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) ld)))
           (ur (list 'UNITROW LZA-S 'm iv))
           (rp (lza-mm ur 'pm))
           (rq (lza-mm ur 'qm)))
      (dk-one-le-from! jv 'n)
      (dk-nonzero! 'n)
      (dk-one-le-from! iv 'm)
      (dk-nonzero! 'm)
      (fact 'unitrow-type LZA-S 'm iv)
      (lza-cite! 'matmul-type LZA-S 1 'm 'n ur 'pm)
      (lza-cite! 'matmul-type LZA-S 1 'm 'n ur 'qm)
      (let* ((e1 (dk-cite! 'row-matact-lincomb 'md 'm 'n 'pm 'xs iv))
             (e2 (dk-cite! 'row-matact-lincomb 'md 'm 'n 'qm 'xs iv))
             (eq (list '= (list 'LINCOMB 'md 'n rp 'xs) (list 'LINCOMB 'md 'n rq 'xs))))
        (dk-have! eq
          (lambda ()
            (subst e1) (subst e2)
            (subst (list '= (lza-ma 'pm 'xs) (lza-ma 'qm 'xs)))
            (lza-cite! 'matact-type 'md 'm 'n 1 'qm 'xs)
            (fact 'one-in-interval-1)
            (fact 'entry-in-carrier 'm 1 '(VEC md) (lza-ma 'qm 'xs) iv 1)
            (rfl)))
        (let ((all (dk-cite! 'rel-free-lincomb-cancel 'md 'n rp rq 'xs)))
          (dk-apply! all jv)
          (dk-cite! 'unitrow-matmul-entry LZA-S 'm 'n 'pm iv jv)
          (dk-cite! 'unitrow-matmul-entry LZA-S 'm 'n 'qm iv jv)
          (subst (list '= (list 'ENTRY 'pm iv jv) (list 'ENTRY rp 1 jv)))
          (subst (list '= (list 'ENTRY 'qm iv jv) (list 'ENTRY rq 1 jv)))
          (ass))))))
(ass)
(lza-done! 'rel-free-matact-cancel)
(topic! 'rel-free-matact-cancel 'algebra)
(gloss! 'rel-free-matact-cancel "Two matrices acting identically on a relation-free sequence are equal.")

;;; =====================================================================
;;; (5) spans-coeff-matrix: the SPANS twin of generates-coeff-matrix
;;;     (rake-generates-coeff.scm; the same four stages, the row family read off
;;;     SPANS instead of GENERATES).
;;; =====================================================================
(define (lza-sep i)
  (list 'SEP 'c_ (list 'MAT 1 'n LZA-CS)
        (list '= (list 'ENTRY 'ys i 1) (list 'LINCOMB 'md 'n 'c_ 'xs))))
(define (lza-row i) (list 'CHOICE (lza-sep i)))
(define LZA-G (list 'VNB-LAMBDA '(LIST i_ j_) '(CARTESIAN (INTERVAL 1 m) (INTERVAL 1 n))
                    (list 'ENTRY (lza-row 'i_) 1 'j_)))
(define LZA-CM (list 'MATOF 'm 'n LZA-G))
(define LZA-CMA (list 'MATACT 'md LZA-CM 'xs))
(define LZA-FAM
  (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 m))
    (list 'AND (list 'IN (lza-row 'i_) (list 'MAT 1 'n LZA-CS))
               (list '= (list 'ENTRY 'ys 'i_ 1) (list 'LINCOMB 'md 'n (lza-row 'i_) 'xs))))))
(define LZA-CM-TYPE (list 'IN LZA-CM (list 'MAT 'm 'n LZA-CS)))
(define (lza-lincomb-finsum c)
  (list 'FINSUM '(MODULE-VECTOR-AG md)
        (list 'VNB-LAMBDA 'j '(INTERVAL 1 n) (list '(ACT md) (list 'ENTRY c 1 'j) '(ENTRY xs j 1)))
        '(INTERVAL 1 n)))
(define LZA-UNFOLD (list 'FORALL 'c_ (list '== (list 'LINCOMB 'md 'n 'c_ 'xs) (lza-lincomb-finsum 'c_))))
(define LZA-ENT-SM '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 m)) (IN (ENTRY ys j_ 1) sm))))
(define (lza-eigen landed cls)
  (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
    (if (not f) (error "lza-eigen: nothing landed in" cls))
    (cadr f)))

(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(n m xs ys sm)
    (list '(IN xs (MAT n 1 (VEC md))) '(IN ys (MAT m 1 (VEC md))) '(IMPLIES (= n 0) (= m 0))
          '(SPANS md n xs sm) LZA-ENT-SM)
    (list 'FORSOME 'cm (list 'AND (list 'IN 'cm (list 'MAT 'm 'n LZA-CS)) '(= ys (MATACT md cm xs))))))))
(dk-peel!)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(fact 'mat-rows-in-nn 'm 1 '(VEC md) 'ys)
(fact 'one-in-interval-1)
(have! LZA-UNFOLD (lambda () (di) (mac 'LINCOMB) (qrfl)))
(dk-focus-having! LZA-UNFOLD)
;; (1) the row family
(have! LZA-FAM
  (lambda ()
    (let* ((ld (dk-peel!))
           (iv (lza-eigen ld '(INTERVAL 1 m))))
      (fact 'entry-in-carrier 'm 1 '(VEC md) 'ys iv 1)
      (dk-apply! LZA-ENT-SM iv)
      (let* ((sp0 (dk-landed-1 (lambda () (mac-h 'SPANS '(SPANS md n xs sm)))))
             (parts (dk-split! sp0))
             (gen (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LINCOMB))) parts))
             (ex (dk-deepest (lambda () (inst+ gen (list 'ENTRY 'ys iv 1)))))
             (w (dk-skolem! ex)))
        (choose! (lza-sep iv) w (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
        (both! (lambda () (ass)) (lambda () (ass)))))))
(dk-focus-having! LZA-FAM)
;; (2) cm is an m-by-n matrix of scalars
(have! LZA-CM-TYPE
  (lambda ()
    (dk-matof!)
    (let* ((ld (dk-peel!))
           (iv (lza-eigen ld '(INTERVAL 1 m)))
           (jv (lza-eigen ld '(INTERVAL 1 n))))
      (lam-b)
      (dk-split! (dk-deepest (lambda () (inst+ LZA-FAM iv))))
      (fact 'entry-in-carrier 1 'n LZA-CS (lza-row iv) 1 jv)
      (ass))))
(dk-focus-having! LZA-CM-TYPE)
;; (3) entry-of-matof's definedness premise, read off the chain
(define LZA-EOM0 (dk-fact! 'entry-of-matof 'm 'n LZA-G 1 1))
(if (not (and (pair? LZA-EOM0) (eq? (car LZA-EOM0) 'IMPLIES)))
    (error "lza: entry-of-matof's chain is not an implication" (expression->string LZA-EOM0)))
(define LZA-DEFSET (cadr LZA-EOM0))
(have! LZA-DEFSET
  (lambda ()
    (let* ((ld (dk-peel!))
           (iv (lza-eigen ld '(INTERVAL 1 m)))
           (jv (lza-eigen ld '(INTERVAL 1 n))))
      (lam-b)
      (dk-split! (dk-deepest (lambda () (inst+ LZA-FAM iv))))
      (fact 'entry-in-carrier 1 'n LZA-CS (lza-row iv) 1 jv)
      (fact 'membership-implies-sethood (list 'ENTRY (lza-row iv) 1 jv) LZA-CS)
      (ass))))
(dk-focus-having! LZA-DEFSET)
;; (4) the action is m-by-1, and its entries are ys's
(dk-have-prop! '(IMPLIES (= n 0) (OR (= m 0) (= 1 0))))
(fact 'matact-type 'md 'm 'n 1 LZA-CM 'xs)
(detach-with! (dk-fact! 'matrix-entry-extensionality 'm 1 '(VEC md) 'ys LZA-CMA)
  (lambda ()
    (let* ((ld (dk-peel!))
           (iv (lza-eigen ld '(INTERVAL 1 m)))
           (jv (lza-eigen ld '(INTERVAL 1 1))))
      (fact 'interval-elt-in-nn 1 1 jv)
      (fact 'interval-hi 1 1 jv)
      (fact 'interval-lo 1 1 jv)
      (fact 'nn-one-in)
      (fact 'nn-le-antisym jv 1)
      (subst (list '= jv 1))
      (dk-one-le-from! iv 'm)
      (dk-nonzero! 'm)
      (dk-have-prop! '(NOT (= n 0)))
      (dk-one-le! 'n)
      (let* ((mae (dk-fact! 'matact-entry 'md 'm 'n 1 LZA-CM 'xs iv 1))
             (fam (dk-deepest (lambda () (inst+ LZA-FAM iv)))))
        (dk-split! fam)
        (subst (list '= (list 'ENTRY 'ys iv 1) (list 'LINCOMB 'md 'n (lza-row iv) 'xs)))
        (subst mae)
        (subst (dk-deepest (lambda () (inst+ LZA-UNFOLD (lza-row iv)))))
        (let* ((g (dk-goal)) (lhs (cadr g)) (rhs (caddr g)) (fl (caddr lhs)) (gl (caddr rhs)))
          (if (not (and (pair? lhs) (eq? (car lhs) 'FINSUM) (pair? rhs) (eq? (car rhs) 'FINSUM)))
              (error "lza: the entry goal is not an equation of FINSUMs" (expression->string g)))
          (fact 'module-vector-ag-is-abelian-group 'md)
          (fact 'interval-in-set 1 'n)
          (fact 'interval-card-in-nn 1 'n)
          (fact 'matact-summand-type 'md 1 'n 1 (lza-row iv) 'xs 1 1)
          (detach-with!
            (dk-fact! 'finsum-congruence-guarded '(MODULE-VECTOR-AG md) '(INTERVAL 1 n) fl gl)
            (lambda ()
              (let* ((ld2 (dk-peel!))
                     (zv (lza-eigen ld2 '(INTERVAL 1 n))))
                (fact 'entry-in-carrier 1 'n LZA-CS (lza-row iv) 1 zv)
                (fact 'entry-in-carrier 'n 1 '(VEC md) 'xs zv 1)
                (fact 'module-act-type 'md (list 'ENTRY (lza-row iv) 1 zv) (list 'ENTRY 'xs zv 1))
                (lam-b)
                (let ((eo (dk-fact! 'entry-of-matof 'm 'n LZA-G iv zv)))
                  (lam-b-h eo)
                  (subst (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list 'ENTRY LZA-CM iv zv))))
                                     (dk-asms)))
                  (rfl)))))
          (ass))))))
(ew LZA-CM)
(both! (lambda () (ass)) (lambda () (ass)))
(lza-done! 'spans-coeff-matrix)
(topic! 'spans-coeff-matrix 'algebra)
(gloss! 'spans-coeff-matrix "A sequence of elements of a submodule spanned by xs is a coefficient matrix times xs.")

;;; =====================================================================
;;; (6) Two relation-free sequences spanning the same submodule differ by an
;;;     invertible matrix.
;;; =====================================================================
(define LZA-ID '(IDENTMAT (SCAL md) n))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(n xs ys sm)
    '((IN xs (MAT n 1 (VEC md))) (IN ys (MAT n 1 (VEC md)))
      (SPANS md n xs sm) (REL-FREE md n xs) (SPANS md n ys sm) (REL-FREE md n ys))
    '(FORSOME pm (AND (IS-INVERTIBLE-MAT (SCAL md) n pm) (= ys (MATACT md pm xs))))))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(fact 'identmat-type LZA-S 'n)
(dk-have-prop! '(IMPLIES (= n 0) (= n 0)))
;; the entries of each sequence lie in sm
(define (lza-entries! zs)
  (let* ((parts (lza-open! 'SPANS 'md 'n zs 'sm))
         (ent (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f 'LINCOMB)))) parts)))
    ent))
(lza-entries! 'xs)
(lza-entries! 'ys)
;; the two coefficient matrices
(define (lza-coeff! from to)
  (let* ((ex (dk-cite! 'spans-coeff-matrix 'md 'n 'n from to 'sm)))
    (dk-skolem! ex)))
(let* ((am (lza-coeff! 'xs 'ys))          ; ys = am . xs
       (bm (lza-coeff! 'ys 'xs))          ; xs = bm . ys
       (ba (lza-mm bm am))
       (ab (lza-mm am bm)))
  (lza-cite! 'matmul-type LZA-S 'n 'n 'n bm am)
  (lza-cite! 'matmul-type LZA-S 'n 'n 'n am bm)
  (let* ((as1 (lza-cite! 'matact-assoc 'md 'n 'n 'n 1 bm am 'xs))
         (as2 (lza-cite! 'matact-assoc 'md 'n 'n 'n 1 am bm 'ys))
         (i1 (dk-cite! 'matact-identmat 'md 'n 1 'xs))
         (i2 (dk-cite! 'matact-identmat 'md 'n 1 'ys)))
    (dk-have! (list '= (lza-ma ba 'xs) (lza-ma LZA-ID 'xs))
      (lambda ()
        (subst as1)
        (subst (list '= (lza-ma am 'xs) 'ys))
        (subst (list '= (lza-ma bm 'ys) 'xs))
        (subst i1)
        (rfl)))
    (dk-have! (list '= (lza-ma ab 'ys) (lza-ma LZA-ID 'ys))
      (lambda ()
        (subst as2)
        (subst (list '= (lza-ma bm 'ys) 'xs))
        (subst (list '= (lza-ma am 'xs) 'ys))
        (subst i2)
        (rfl)))
    (dk-cite! 'rel-free-matact-cancel 'md 'n 'n 'xs ba LZA-ID)
    (dk-cite! 'rel-free-matact-cancel 'md 'n 'n 'ys ab LZA-ID)
    (dk-cite! 'inverse-is-invertible LZA-S 'n bm am)
    (ew am)
    (dk-conj-close! (lambda () (ass)))))
(lza-done! 'spans-rel-free-transitive)
(topic! 'spans-rel-free-transitive 'algebra)
(gloss! 'spans-rel-free-transitive "Two relation-free sequences of the same length spanning the same submodule differ by an invertible matrix.")

;;; =====================================================================
;;; (7) Corollary 3.43.
;;; =====================================================================
(define LZA-FREE-GEN (lambda (zs) (list (list 'GENERATES 'md 'n zs) (list 'REL-FREE 'md 'n zs))))

;; the action maps free generating sequences to free generating sequences
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(n xs pm)
    (append (list '(IN xs (MAT n 1 (VEC md))) '(IS-INVERTIBLE-MAT (SCAL md) n pm)) (LZA-FREE-GEN 'xs))
    '(AND (GENERATES md n (MATACT md pm xs)) (REL-FREE md n (MATACT md pm xs)))))))
(dk-peel!)
(dk-cite! 'generates-transport 'md 'n 'xs 'pm)
(dk-cite! 'free-transport 'md 'n 'xs 'pm)
(dk-conj-close! (lambda () (ass)))
(lza-done! 'free-generating-action-closed)
(topic! 'free-generating-action-closed 'algebra)
(gloss! 'free-generating-action-closed "Linear algebra 3.43 (setting): an invertible matrix carries a free generating sequence to a free generating sequence.")

;; free: two invertible matrices acting identically on a free generating sequence are equal
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(n xs pm qm)
    (append (list '(IN xs (MAT n 1 (VEC md))))
            (LZA-FREE-GEN 'xs)
            (list '(IS-INVERTIBLE-MAT (SCAL md) n pm) '(IS-INVERTIBLE-MAT (SCAL md) n qm)
                  '(= (MATACT md pm xs) (MATACT md qm xs))))
    '(= pm qm)))))
(dk-peel!)
(dk-cite! 'invertible-mat-is-mat LZA-S 'n 'pm)
(dk-cite! 'invertible-mat-is-mat LZA-S 'n 'qm)
(dk-cite! 'rel-free-matact-cancel 'md 'n 'n 'xs 'pm 'qm)
(ass)
(lza-done! 'free-generating-action-free)
(topic! 'free-generating-action-free 'algebra)
(gloss! 'free-generating-action-free "Linear algebra 3.43: the action of the invertible matrices on the free generating sequences is free.")

;; the stabiliser form: A . u = u forces A = I
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(n xs pm)
    (append (list '(IN xs (MAT n 1 (VEC md))))
            (LZA-FREE-GEN 'xs)
            (list '(IS-INVERTIBLE-MAT (SCAL md) n pm) '(= (MATACT md pm xs) xs)))
    (list '= 'pm LZA-ID)))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(fact 'identmat-type LZA-S 'n)
(dk-cite! 'invertible-mat-is-mat LZA-S 'n 'pm)
(let ((i1 (dk-cite! 'matact-identmat 'md 'n 1 'xs)))
  (dk-have! (list '= (lza-ma 'pm 'xs) (lza-ma LZA-ID 'xs))
    (lambda () (subst i1) (ass))))
(dk-cite! 'rel-free-matact-cancel 'md 'n 'n 'xs 'pm LZA-ID)
(ass)
(lza-done! 'free-generating-action-stabilizer)
(topic! 'free-generating-action-stabilizer 'algebra)
(gloss! 'free-generating-action-stabilizer "Linear algebra 3.43: the only invertible matrix fixing a free generating sequence is the identity.")

;; transitive
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md))
  (forall-guarded '(n xs ys)
    (append (list '(IN xs (MAT n 1 (VEC md))) '(IN ys (MAT n 1 (VEC md)))) (LZA-FREE-GEN 'xs) (LZA-FREE-GEN 'ys))
    '(FORSOME pm (AND (IS-INVERTIBLE-MAT (SCAL md) n pm) (= ys (MATACT md pm xs))))))))
(dk-peel!)
(fact 'mat-rows-in-nn 'n 1 '(VEC md) 'xs)
(dk-cite! 'generates-implies-spans-vec 'md 'n 'xs)
(dk-cite! 'generates-implies-spans-vec 'md 'n 'ys)
(dk-cite! 'spans-rel-free-transitive 'md 'n 'xs 'ys '(VEC md))
(ass)
(lza-done! 'free-generating-action-transitive)
(topic! 'free-generating-action-transitive 'algebra)
(gloss! 'free-generating-action-transitive "Linear algebra 3.43: any two free generating sequences of the same length differ by an invertible matrix.")
