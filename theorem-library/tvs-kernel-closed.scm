;;; =====================================================================
;;; (3) A REAL TOPOLOGICAL VECTOR SPACE: TRANSLATES AND DILATES OF OPEN SETS
;;; =====================================================================
(define tkr-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define tkr-tvs '(IS-TVS RR-NORMED-FIELD m t))
(define tkr-addc
  (forall-guarded '(tvx_ tvy_ tvu_)
    '((IN tvx_ (VEC m)) (IN tvy_ (VEC m)) (IN tvu_ (OPENS t)) (IN ((VADD m) tvx_ tvy_) tvu_))
    '(FORSOME tvv_ (AND (IN tvv_ (OPENS t)) (AND (IN tvx_ tvv_)
       (FORSOME tvw_ (AND (IN tvw_ (OPENS t)) (AND (IN tvy_ tvw_)
         (FORALL tva_ (IMPLIES (IN tva_ tvv_) (FORALL tvb_ (IMPLIES (IN tvb_ tvw_)
           (IN ((VADD m) tva_ tvb_) tvu_)))))))))))))
(define tkr-scalc
  (forall-guarded '(tvr_ tvx_ tvu_)
    '((IN tvr_ (CARR (SCAL m))) (IN tvx_ (VEC m)) (IN tvu_ (OPENS t)) (IN ((ACT m) tvr_ tvx_) tvu_))
    '(FORSOME tvd_ (AND (POS-RR tvd_)
       (FORSOME tvw_ (AND (IN tvw_ (OPENS t)) (AND (IN tvx_ tvw_)
         (FORALL tvs_ (IMPLIES (IN tvs_ (CARR (SCAL m)))
           (IMPLIES (< ((FNRM RR-NORMED-FIELD) ((ADD (SCAL m)) tvs_ ((NEG (SCAL m)) tvr_))) tvd_)
             (FORALL tva_ (IMPLIES (IN tva_ tvw_) (IN ((ACT m) tvs_ tva_) tvu_)))))))))))))
(define (tkr-tvs-parts!)
  (if (not (dk-asm? '(IS-TOP-SPACE t)))
      (begin
        (dk-project! '(IS-MODULE m) 'is-tvs tkr-tvs)
        (dk-project! (list '= '(SCAL m) tkr-ring) 'is-tvs tkr-tvs)
        (dk-project! '(== (PTS t) (VEC m)) 'is-tvs tkr-tvs)
        (dk-project! tkr-addc 'is-tvs tkr-tvs)
        (dk-project! tkr-scalc 'is-tvs tkr-tvs)
        (dk-project! '(IS-HAUSDORFF t) 'is-tvs tkr-tvs)
        (dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
        (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t)))))
(define (tkr-carr! r)
  (let ((ty (list 'IN r '(CARR (SCAL m)))))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst (list '= '(SCAL m) tkr-ring)) (mac 'rr-scalar-ring-carr) (ass))))
    ty))
;; a1 in w, w open  =>  a1 in VEC m
(define (tkr-open-pt! w a1)
  (let ((ty (list 'IN a1 '(VEC m))))
    (if (not (dk-asm? ty))
        (begin
          (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) w)
          (dk-cite! 'power-mem-in '(PTS t) w a1)
          (dk-rewrite-h! (list 'IN a1 '(PTS t)) '(PTS t) '(VEC m))))
    ty))
(define (tkr-pts! a1)   ; a1 in VEC m  =>  a1 in PTS t
  (let ((ty (list 'IN a1 '(PTS t))))
    (if (not (dk-asm? ty)) (dk-have! ty (lambda () (subst '(= (PTS t) (VEC m))) (ass))))
    ty))

;; scalar multiplication is continuous, read with RR's own subtraction and |.|
(define (tkr-scal-rr-body r x u)
  (list 'FORSOME 'tsd_ (list 'AND '(POS-RR tsd_) (list 'FORSOME 'tsw_ (list 'AND '(IN tsw_ (OPENS t)) (list 'AND (list 'IN x 'tsw_)
    (list 'FORALL 'tss_ (list 'IMPLIES '(IN tss_ RR) (list 'IMPLIES (list '< (list 'abs (list '- 'tss_ r)) 'tsd_)
      (list 'FORALL 'tsa_ (list 'IMPLIES '(IN tsa_ tsw_) (list 'IN '((ACT m) tss_ tsa_) u))))))))))))
(sp (make-wff (forall-guarded '(m t r x u) (list tkr-tvs '(IN r RR) '(IN x (VEC m)) '(IN u (OPENS t)) '(IN ((ACT m) r x) u))
                              (tkr-scal-rr-body 'r 'x 'u))))
(dk-peel!)
(tkr-tvs-parts!)
(tkr-carr! 'r)
(let* ((ex (dk-apply! tkr-scalc 'r 'x 'u))
       (d (dk-skolem! ex 'top))
       (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tvw_))) (dk-asms)))
       (w (dk-skolem! ex2 #t))
       (cl (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'tvs_))) (dk-asms))))
  (ew d)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((ld (dk-peel!))
                           (s (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))
                           (fn (list '(FNRM RR-NORMED-FIELD) (list '(ADD (SCAL m)) s (list '(NEG (SCAL m)) 'r)))))
                      (tkr-carr! s)
                      (tkr-real! (list '- s 'r))
                      (tkr-real! (list '+ s '(- r)))
                      (dk-have! (list '= fn (list 'abs (list '- s 'r)))
                        (lambda ()
                          (subst (list '= '(SCAL m) tkr-ring))
                          (mac 'rr-scalar-ring-neg)
                          (mac 'rr-scalar-ring-add)
                          (dk-lam-b!)
                          (subst (dk-cite! 'rr-nf-fnrm-apply (list '+ s '(- r))))
                          (subst (tkr-eq! (list '+ s '(- r)) (list '- s 'r)))
                          (tkr-real! (list 'abs (list '- s 'r)))
                          (rfl)))
                      (dk-rewrite-h! (dk-ctx-form (list '< (list 'abs (list '- s 'r)) d)) (list 'abs (list '- s 'r)) fn)
                      (let ((a1 (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) w))) ld))))
                        (dk-apply! cl s a1))
                      (dk-ass!))))))))))
(tkr-qed! 'tvs-scal-cont-rr)

;; x + (-1).x0 in w defines an open set: the translate of w by x0
(define (tkr-trans w x0) (list 'SEP 'trx_ '(VEC m) (list 'IN (list '(VADD m) 'trx_ (list '(ACT m) '(- 1) x0)) w)))
(define (tkr-loc-of a) (list 'FORALL 'tlx_ (list 'IMPLIES (list 'IN 'tlx_ a)
                         (list 'FORSOME 'tlw_ (list 'AND '(IN tlw_ (OPENS t)) (list 'AND '(IN tlx_ tlw_) (list 'SUBSET 'tlw_ a)))))))
(define (tkr-sub-pts! a)   ; a = (SEP v (VEC m) ..): SUBSET a (PTS t)
  (dk-have! (list 'SUBSET a '(PTS t))
    (lambda () (mac 'subset-def)
               (let ((z (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN z a))) (dk-split-all!) (tkr-pts! z) (ass)))))
(sp (make-wff (forall-guarded '(m t w x0) (list tkr-tvs '(IN w (OPENS t)) '(IN x0 (VEC m)))
                              (list 'IN (tkr-trans 'w 'x0) '(OPENS t)))))
(dk-peel!)
(tkr-tvs-parts!)
(let* ((a (tkr-trans 'w 'x0)) (nx0 (list '(ACT m) '(- 1) 'x0)))
  (tkr-vtype! nx0)
  (tkr-sub-pts! a)
  (dk-have! (tkr-loc-of a)
    (lambda ()
      (let ((z (dk-di-var!)))
        (sep-me (dk-ctx-form (list 'IN z a)))
        (dk-split-all!)
        (let* ((ex (dk-apply! tkr-addc z nx0 'w))
               (v1 (dk-skolem! ex #t))
               (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tvw_) (dk-contains? f v1))) (dk-asms)))
               (v2 (dk-skolem! ex2 #t))
               (cl (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v1) (dk-contains? f v2))) (dk-asms))))
          (ew v1)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (mac 'subset-def)
                    (let ((a1 (dk-di-var!)))
                      (tkr-open-pt! v1 a1)
                      (in-sep! (lambda () (ass))
                               (lambda () (dk-apply! cl a1 nx0) (dk-ass!))))))))))))
  (dk-cite! 'top-open-of-local 't a)
  (ass))
(tkr-qed! 'tvs-translate-open)

;; c.x in w defines an open set
(define (tkr-dil c w) (list 'SEP 'scx_ '(VEC m) (list 'IN (list '(ACT m) c 'scx_) w)))
(sp (make-wff (forall-guarded '(m t c w) (list tkr-tvs '(IN c RR) '(IN w (OPENS t)))
                              (list 'IN (tkr-dil 'c 'w) '(OPENS t)))))
(dk-peel!)
(tkr-tvs-parts!)
(let* ((a (tkr-dil 'c 'w)))
  (tkr-sub-pts! a)
  (dk-have! (tkr-loc-of a)
    (lambda ()
      (let ((z (dk-di-var!)))
        (sep-me (dk-ctx-form (list 'IN z a)))
        (dk-split-all!)
        (let* ((ex (dk-cite! 'tvs-scal-cont-rr 'm 't 'c z 'w))
               (d (dk-skolem! ex 'top))
               (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tsw_))) (dk-asms)))
               (w2 (dk-skolem! ex2 #t))
               (cl (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'tss_))) (dk-asms))))
          (dk-cite! 'rr-pos-rr-in-rr d)
          (dk-cite! 'rr-lt-of-pos-rr d)
          (tkr-real! '(- c c))
          (dk-have! (list '< '(abs (- c c)) d)
            (lambda ()
              (subst (tkr-eq! '(- c c) 0))
              (fact 'rr-abs-zero-value)
              (subst '(= (abs 0) 0))
              (ass)))
          (let ((cl2 (dk-apply! cl 'c)))
            (ew w2)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (mac 'subset-def)
                      (let ((a1 (dk-di-var!)))
                        (tkr-open-pt! w2 a1)
                        (in-sep! (lambda () (ass))
                                 (lambda () (dk-apply! cl2 a1) (dk-ass!)))))))))))))
  (dk-cite! 'top-open-of-local 't a)
  (ass))
(tkr-qed! 'tvs-dilate-open)

;;; =====================================================================
;;; (4) THE KERNEL AND THE BOUNDED NEIGHBOURHOOD
;;; =====================================================================
(define tkr-ker '(FKER m f))
(sp (make-wff '(FORALL m (FORALL f (FORALL z (IFF (IN z (FKER m f)) (AND (IN z (VEC m)) (= (f z) 0))))))))
(dk-peel!)
(mac 'FKER)
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-head-is? (dk-goal) 'AND)
        (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
          (sep-me h) (dk-split-all!) (dk-conj-close! (lambda () (ass))))
        (begin (dk-split-all!) (in-sep! (lambda () (ass)) (lambda () (ass))))))
  (dk-opened (lambda () (di))))
(tkr-qed! 'fker-membership)

(sp (make-wff (list 'FORALL 'v (list 'IFF (list 'IN 'v tkr-nz) '(AND (IN v RR) (NOT (= v 0)))))))
(dk-peel!)
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-head-is? (dk-goal) 'AND)
        (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
          (sep-me h) (dk-split-all!) (dk-conj-close! (lambda () (ass))))
        (begin (dk-split-all!) (in-sep! (lambda () (ass)) (lambda () (ass))))))
  (dk-opened (lambda () (di))))
(tkr-qed! 'rr-nonzero-membership)

(define tkr-lf '(IS-LINEAR-FUNCTIONAL m f))
(define tkr-fadd '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m)) (= (f ((VADD m) x_ y_)) (+ (f x_) (f y_))))))))
(define tkr-fhom '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC m)) (= (f ((ACT m) r_ x_)) (* r_ (f x_))))))))
(define (tkr-lf-parts!)
  (if (not (dk-asm? '(IN f (FUN (VEC m) RR))))
      (begin
        (dk-project! '(IN f (FUN (VEC m) RR)) 'is-linear-functional tkr-lf)
        (dk-project! tkr-fadd 'is-linear-functional tkr-lf)
        (dk-project! tkr-fhom 'is-linear-functional tkr-lf))))
(define tkr-cker (list 'COMPLEMENT-IN '(PTS t) tkr-ker))
;; name recip(c) for c /= 0: lands v in RR, c * v = 1; returns v
(define (tkr-recip! c)
  (tkr-and! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
  (dk-cite! 'rr-recip-closed c)
  (dk-cite! 'rr-recip-inverse c)
  (let ((v (dk-name! (list 'recip c))))
    (dk-have! (list '= (list '* c v) 1) (lambda () (subst (list '= v (list 'recip c))) (ass)))
    v))
(define (tkr-nz-of-pos! c)
  (let ((f (list 'NOT (list '= c 0))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (di) (dk-rewrite-h! (dk-ctx-form (list '< 0 c)) c 0)
                               (dk-cite! 'rr-zero-in) (dk-cite! 'rr-lt-irrefl 0) (ai '(NOT (< 0 0))))))
    f))

(define tkr-bw-body
  '(FORSOME bw_ (AND (IN bw_ (OPENS t)) (AND (IN (VZERO m) bw_) (FORALL bwz_ (IMPLIES (IN bwz_ bw_) (<= (abs (f bwz_)) eps)))))))
(sp (make-wff (forall-guarded '(m t f a eps)
                (list tkr-tvs tkr-lf (list 'IN tkr-cker '(OPENS t)) '(IN a (VEC m)) '(IN eps RR) '(< 0 eps) '(= (f a) eps))
                tkr-bw-body)))
(dk-peel!)
(tkr-tvs-parts!)
(tkr-lf-parts!)
(let* ((z0 '(VZERO m)) (cker tkr-cker))
  (tkr-vtype! z0)
  ;; a is off the kernel
  (dk-have! (list 'IN 'a cker)
    (lambda ()
      (mac 'complement-in-membership)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'NOT)
              (begin
                (di)
                (let ((m1 (dk-cite! 'fker-membership 'm 'f 'a)))
                  (tkr-real! '(f a))
                  (dk-only! m1 (list 'IN 'a tkr-ker) '(= (f a) eps) '(< 0 eps) '(IN eps RR) '(IN (f a) RR))
                  (dk-have! '(AND (IN a (VEC m)) (= (f a) 0)) (lambda () (prop)))
                  (dk-split! '(AND (IN a (VEC m)) (= (f a) 0)))
                  (dk-absurd! '(= (f a) eps) '(= (f a) 0) '(< 0 eps) '(IN eps RR) '(IN (f a) RR))))
              (tkr-pts! 'a))))))
  (dk-cite! 'rmod-vzero-right 'm 'a)
  (dk-have! (list 'IN (list '(VADD m) 'a z0) cker) (lambda () (subst (list '= (list '(VADD m) 'a z0) 'a)) (ass)))
  (let* ((ex (dk-apply! tkr-addc 'a z0 cker))
         (v1 (dk-skolem! ex #t))
         (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tvw_) (dk-contains? f v1))) (dk-asms)))
         (v2 (dk-skolem! ex2 #t))
         (cl12 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v1) (dk-contains? f v2))) (dk-asms))))
    (tkr-real! 0)
    (dk-cite! 'rmod-act-zero 'm z0)
    (dk-have! (list 'IN (list '(ACT m) 0 z0) v2) (lambda () (subst (list '= (list '(ACT m) 0 z0) z0)) (ass)))
    (let* ((ex3 (dk-cite! 'tvs-scal-cont-rr 'm 't 0 z0 v2))
           (d (dk-skolem! ex3 'top))
           (ex4 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tsw_))) (dk-asms)))
           (w (dk-skolem! ex4 #t))
           (clw (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'tss_) (dk-contains? f w))) (dk-asms)))
           (h (list '* 1/2 d)))
      (dk-cite! 'rr-pos-rr-in-rr d)
      (dk-cite! 'rr-lt-of-pos-rr d)
      (tkr-real! h)
      (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
      (dk-have! (list '< h d) (lambda () (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
      (tkr-nz-of-pos! h)
      (let* ((rh (tkr-recip! h))
             (wp (tkr-dil rh w)))
        (dk-cite! 'tvs-dilate-open 'm 't rh w)
        (dk-cite! 'rmod-act-vzero 'm rh)
        (dk-have! (list 'IN z0 wp)
          (lambda () (in-sep! (lambda () (ass)) (lambda () (subst (list '= (list '(ACT m) rh z0) z0)) (ass)))))
        (ew wp)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let ((z (dk-di-var!)))
                  (sep-me (dk-ctx-form (list 'IN z wp)))
                  (dk-split-all!)
                  (let* ((fz (list 'f z)) (afz (list 'abs fz)) (w0 (list '(ACT m) rh z)))
                    (tkr-real! fz) (tkr-real! afz)
                    (use-em (list '<= afz 'eps)
                      (lambda () (ass))
                      (lambda ()
                        (dk-cite! 'rr-not-le-lt afz 'eps)
                        (dk-have! (list 'NOT (list '= fz 0))
                          (lambda ()
                            (di)
                            (let* ((h1 (dk-rewrite-h! (dk-ctx-form (list '< 'eps afz)) fz 0)))
                              (fact 'rr-abs-zero-value)
                              (let ((h2 (dk-rewrite-h! h1 '(abs 0) 0)))
                                (dk-absurd! h2 '(< 0 eps) '(IN eps RR))))))
                        (let* ((rf (tkr-recip! fz))
                               (s (list '* '(- eps) rf))
                               (as (list 'abs s)))
                          (tkr-real! s) (tkr-real! as)
                          (dk-have! (list '= (list '* s fz) '(- eps))
                            (lambda ()
                              (subst (tkr-eq! (list '* s fz) (list '* '(- eps) (list '* fz rf))))
                              (subst (list '= (list '* fz rf) 1))
                              (crs)))
                          ;; |s| |f z| = eps
                          (tkr-and! (list 'IN s 'RR) (list 'IN fz 'RR))
                          (dk-cite! 'rr-abs-mult s fz)
                          (dk-cite! 'rr-abs-neg 'eps)
                          (dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps) '(IN eps RR))))
                          (dk-cite! 'rr-abs-of-nonneg 'eps)
                          (let ((sfz (list '* as afz)))
                            (tkr-real! sfz)
                            (dk-have! (list '= sfz 'eps)
                              (lambda ()
                                (subst (list '= sfz (list 'abs (list '* s fz))))
                                (subst (list '= (list '* s fz) '(- eps)))
                                (subst '(= (abs (- eps)) (abs eps)))
                                (subst '(= (abs eps) eps))
                                (rfl)))
                            ;; |s| < 1
                            (dk-cite! 'rr-abs-nonneg s)
                            (tkr-real! 1)
                            (dk-cite! 'rr-lt-trichotomy as 1)
                            (dk-have! (list '< as 1)
                              (lambda ()
                                (use-em (list '< as 1)
                                  (lambda () (ass))
                                  (lambda ()
                                    (dk-have! (list '<= 1 as)
                                      (lambda () (dk-only! (dk-ctx-form (list 'OR (list '< as 1) (list 'OR (list '= as 1) (list '< 1 as))))
                                                           (list 'NOT (list '< as 1)) (list 'IN as 'RR))
                                                 (use-em (list '= as 1)
                                                   (lambda () (dk-ineq! (list '= as 1) (list 'IN as 'RR)))
                                                   (lambda () (dk-have! (list '< 1 as) (lambda () (prop)))
                                                              (dk-ineq! (list '< 1 as) (list 'IN as 'RR))))))
                                    (dk-cite! 'rr-abs-nonneg fz)
                                    (let* ((m0 (dk-cite! 'rr-mul-le-right 1 as afz))
                                           (m1 (dk-rewrite-h! m0 sfz 'eps))
                                           (e1 (tkr-eq! (list '* 1 afz) afz))
                                           (m2 (dk-rewrite-h! m1 (list '* 1 afz) afz)))
                                      (dk-absurd! m2 (list '< 'eps afz) '(IN eps RR) (list 'IN afz 'RR)))))))
                            ;; sigma = s h: s.z = sigma.(recip(h).z) lands in V2
                            (let* ((sg (list '* s h)) (ah (list 'abs h)))
                              (tkr-real! sg) (tkr-real! (list '- sg 0))
                              (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
                              (dk-have! (list '<= 0 h) (lambda () (dk-ineq! (list '< 0 h) (list 'IN h 'RR))))
                              (tkr-and! (list 'IN s 'RR) (list 'IN h 'RR))
                              (let* ((em (dk-cite! 'rr-abs-mult s h))
                                     (eh (dk-cite! 'rr-abs-of-nonneg h))
                                     (p1 (begin (tkr-real! (list '* as h)) (dk-name! (list '* as h))))
                                     (e2 (dk-have! (list '= (list 'abs (list '- sg 0)) p1)
                                           (lambda () (subst (tkr-eq! (list '- sg 0) sg))
                                                      (subst (list '= (list 'abs sg) (list '* as ah)))
                                                      (subst (list '= ah h))
                                                      (subst (list '= p1 (list '* as h)))
                                                      (rfl))))
                                     (tkr-dummy (tkr-and! (list '< 0 h) (list '< as 1)))
                                     (lt0 (dk-cite! 'rr-lt-scale-pos h as 1))
                                     (e0 (tkr-eq! (list '* h as) (list '* as h)))
                                     (lt1 (dk-rewrite-h! lt0 (list '* h as) (list '* as h)))
                                     (lt2 (dk-rewrite-h! lt1 (list '* as h) p1))
                                     (e3 (tkr-eq! (list '* h 1) h))
                                     (lt3 (dk-rewrite-h! lt2 (list '* h 1) h)))
                                (dk-have! (list '< (list 'abs (list '- sg 0)) d)
                                  (lambda () (subst (list '= (list 'abs (list '- sg 0)) p1))
                                             (dk-ineq! lt3 (list '< h d) (list 'IN p1 'RR) (list 'IN h 'RR) (list 'IN d 'RR))))
                                (let* ((mv (dk-apply! clw sg w0))
                                       (ea (dk-cite! 'rmod-act-mul 'm sg rh z))
                                       (mv2 (dk-rewrite-h! mv (list '(ACT m) sg w0) (list '(ACT m) (list '* sg rh) z)))
                                       (e4 (dk-have! (list '= (list '* sg rh) s)
                                             (lambda () (subst (tkr-eq! (list '* sg rh) (list '* s (list '* h rh))))
                                                        (subst (list '= (list '* h rh) 1))
                                                        (crs))))
                                       (mv3 (dk-rewrite-h! mv2 (list '* sg rh) s))
                                       (sz (list '(ACT m) s z))
                                       (cin (dk-apply! cl12 'a sz))
                                       (asz (list '(VADD m) 'a sz)))
                                  (tkr-vtype! sz) (tkr-vtype! asz)
                                  (mac-h 'complement-in-membership cin)
                                  (dk-split-all!)
                                  (dk-have! (list 'IN asz tkr-ker)
                                    (lambda ()
                                      (mac 'fker-membership)
                                      (dk-conj-close!
                                        (lambda ()
                                          (if (not (dk-ass!))
                                              (begin
                                                (subst (dk-apply! tkr-fadd 'a sz))
                                                (subst (dk-apply! tkr-fhom s z))
                                                (subst '(= (f a) eps))
                                                (subst (list '= (list '* s fz) '(- eps)))
                                                (crs)))))))
                                  (ai (list 'NOT (list 'IN asz tkr-ker)))))))))))))))))))
(tkr-qed! 'tvs-functional-bounded-nbhd)

;;; =====================================================================
;;; (5) Prop 2.11
;;; =====================================================================
(define tkr-ntriv '(FORSOME nta_ (AND (IN nta_ (VEC m)) (NOT (= (f nta_) 0)))))
(define tkr-hom (list 'IS-HOM-TOP-SPACE 't tkr-rt 'f))
(define tkr-closed (list 'IS-TOP-CLOSED 't tkr-ker))

;; closed kernel  =>  continuous
(sp (make-wff (forall-guarded '(m t f) (list tkr-tvs tkr-lf tkr-ntriv tkr-closed) tkr-hom)))
(dk-peel!)
(tkr-tvs-parts!)
(tkr-lf-parts!)
(mac-h 'is-top-closed tkr-closed)
(dk-split-all!)
(dk-split! (dk-cite! 'rr-abs-top-facts))
(let* ((a0 (dk-skolem! (dk-ctx-form tkr-ntriv) #t))
       (fa0 (list 'f a0)))
  (tkr-real! fa0)
  (mac 'is-hom-top-space-def)
  (let loop ((k 0))
    (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
      (if (and l (< k 10)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
  (for-each
    (lambda (l)
      (dk-focus! l)
      (let ((g (dk-goal)))
        (cond
          ((dk-head-is? g 'IS-TOP-SPACE) (ass))
          ((dk-head-is? g 'IN)
           (subst '(= (PTS t) (VEC m)))
           (subst (list '= (list 'PTS tkr-rt) 'RR))
           (ass))
          (#t
           (let* ((u (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                  (pre (list 'PREIMAGE 't 'f u)))
             (dk-have! (list 'SUBSET pre '(PTS t))
               (lambda () (mac 'subset-def)
                          (let ((z (dk-di-var!))) (mac-h 'preimage-membership (list 'IN z pre)) (dk-split-all!) (ass))))
             (dk-have! (tkr-loc-of pre)
               (lambda ()
                 (let* ((x0 (dk-di-var!)))
                   (mac-h 'preimage-membership (list 'IN x0 pre))
                   (dk-split-all!)
                   (dk-rewrite-h! (list 'IN x0 '(PTS t)) '(PTS t) '(VEC m))
                   (let* ((fx0 (list 'f x0))
                          (ex (dk-cite! 'rr-abs-open-ball u fx0))
                          (e (dk-skolem! ex 'top))
                          (bc (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e))) (dk-asms))))
                     (tkr-real! fx0)
                     (dk-cite! 'rr-pos-rr-in-rr e)
                     (dk-cite! 'rr-lt-of-pos-rr e)
                     ;; a = (e recip(f a0)).a0 has f(a) = e
                     (let* ((r0 (tkr-recip! fa0))
                            (c (list '* e r0))
                            (a (list '(ACT m) c a0)))
                       (tkr-real! c) (tkr-vtype! a)
                       (dk-have! (list '= (list 'f a) e)
                         (lambda () (subst (dk-apply! tkr-fhom c a0))
                                    (subst (tkr-eq! (list '* c fa0) (list '* e (list '* fa0 r0))))
                                    (subst (list '= (list '* fa0 r0) 1))
                                    (crs)))
                       (let* ((bw (dk-cite! 'tvs-functional-bounded-nbhd 'm 't 'f a e))
                              (wp (dk-skolem! bw #t))
                              (bnd (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f wp))) (dk-asms)))
                              (nn (tkr-trans wp x0))
                              (nx0 (list '(ACT m) '(- 1) x0)))
                         (dk-cite! 'tvs-translate-open 'm 't wp x0)
                         (tkr-vtype! nx0)
                         (tkr-real! 1) (tkr-real! '(- 1))
                         (let* ((e1 (dk-cite! 'rmod-act-add 'm 1 '(- 1) x0))
                                (o1 (dk-cite! 'rmod-act-one 'm x0))
                                (e2 (dk-rewrite-h! e1 (list '(ACT m) 1 x0) x0))
                                (o2 (tkr-eq! '(+ 1 (- 1)) 0))
                                (e3 (dk-rewrite-h! e2 '(+ 1 (- 1)) 0))
                                (o3 (dk-cite! 'rmod-act-zero 'm x0))
                                (e4 (dk-rewrite-h! e3 (list '(ACT m) 0 x0) '(VZERO m))))
                           #t)
                         (ew nn)
                         (dk-conj-close!
                           (lambda ()
                             (cond
                               ((dk-ass!) #t)
                               ((dk-head-is? (dk-goal) 'IN)
                                (in-sep! (lambda () (ass))
                                         (lambda () (subst (list '= (list '(VADD m) x0 nx0) '(VZERO m))) (ass))))
                               (#t
                                (mac 'subset-def)
                                (let* ((x (dk-di-var!)))
                                  (sep-me (dk-ctx-form (list 'IN x nn)))
                                  (dk-split-all!)
                                  (let* ((dx (list '(VADD m) x nx0))
                                         (fx (list 'f x))
                                         (b0 (dk-apply! bnd dx))
                                         (ea (dk-apply! tkr-fadd x nx0))
                                         (b1 (dk-rewrite-h! b0 (list 'f dx) (list '+ fx (list 'f nx0))))
                                         (eh (dk-apply! tkr-fhom '(- 1) x0))
                                         (b2 (dk-rewrite-h! b1 (list 'f nx0) (list '* '(- 1) fx0)))
                                         (ty (tkr-real! fx))
                                         (e3 (tkr-eq! (list '+ fx (list '* '(- 1) fx0)) (list '- fx fx0)))
                                         (b3 (dk-rewrite-h! b2 (list '+ fx (list '* '(- 1) fx0)) (list '- fx fx0))))
                                    (dk-apply! bc fx)
                                    (mac 'preimage-membership)
                                    (dk-conj-close!
                                      (lambda () (if (not (dk-ass!)) (begin (tkr-pts! x) (ass)))))))))))))))))
             (dk-cite! 'top-open-of-local 't pre)
             (ass))))))
    (dk-open-leaves)))
(tkr-qed! 'tvs-closed-kernel-continuous)

;; continuous  =>  closed kernel
(sp (make-wff (forall-guarded '(m t f) (list tkr-tvs tkr-lf tkr-hom) tkr-closed)))
(dk-peel!)
(tkr-tvs-parts!)
(tkr-lf-parts!)
(let* ((cl (dk-project! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'OPENS tkr-rt)) (list 'IN '(PREIMAGE t f u) '(OPENS t))))
                        'is-hom-top-space-def tkr-hom))
       (pz (list 'PREIMAGE 't 'f tkr-nz)))
  (dk-cite! 'rr-abs-nonzero-open)
  (dk-apply! cl tkr-nz)
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin (mac 'subset-def)
                 (let ((z (dk-di-var!)))
                   (dk-have! (list 'AND (list 'IN z '(VEC m)) (list '= (list 'f z) 0))
                     (lambda () (dk-cite! 'fker-membership 'm 'f z) (prop)))
                   (dk-split! (list 'AND (list 'IN z '(VEC m)) (list '= (list 'f z) 0)))
                   (tkr-pts! z) (ass)))
          (begin
            (dk-have! (list 'FORALL 'cky_ (list 'IFF (list 'IN 'cky_ tkr-cker) (list 'IN 'cky_ pz)))
              (lambda ()
                (let* ((y (dk-di-var! (lambda (g) (cadr (cadr g))))))
                  (for-each
                    (lambda (l)
                      (dk-focus! l)
                      (let* ((ant (if (equal? (caddr (dk-goal)) pz) (list 'IN y tkr-cker) (list 'IN y pz)))
                             (i1 (dk-cite! 'complement-in-membership '(PTS t) tkr-ker y))
                             (i3 (dk-cite! 'preimage-membership 't 'f tkr-nz y)))
                        (dk-have! (list 'IN y '(PTS t)) (lambda () (dk-only! i1 i3 ant) (prop)))
                        (dk-rewrite-h! (list 'IN y '(PTS t)) '(PTS t) '(VEC m))
                        (tkr-real! (list 'f y))
                        (let* ((i2 (dk-cite! 'fker-membership 'm 'f y))
                               (i4 (dk-cite! 'rr-nonzero-membership (list 'f y))))
                          (dk-only! i1 i2 i3 i4 ant (list 'IN y '(VEC m)) (list 'IN y '(PTS t)) (list 'IN (list 'f y) 'RR))
                          (prop))))
                    (dk-opened (lambda () (di)))))))
            (dk-cite! 'class-extensionality tkr-cker pz)
            (subst (list '= tkr-cker pz))
            (ass))))))
(tkr-qed! 'tvs-continuous-kernel-closed)

