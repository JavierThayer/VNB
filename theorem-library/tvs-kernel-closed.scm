;;; tkr.scm -- topological-vector-space.pdf Prop 2.11: a nontrivial linear functional on a real topological
;;; vector space is continuous iff its kernel f^-1(0) is closed.  Agent DUAL-FIX, 2026-10-26.
;;; DESTINATION: theorem-library/tvs-kernel-closed.scm.  Library: analysis.  Helper prefix: tkr-.
;;; Needs: structure-library/top-closed (tkr-vocab.scm here), the TB-01 vocabulary and files (IS-TVS,
;;; SEMINORM-TOP, sn-ball-membership, sntop-*, nvs-norm-family, rr-nvs-norm-apply, rr-nvs-vec), and
;;; theorem-library/tvs-minkowski (rmod-*), dual-nvs (dual-rr-*).
;;;
;;; R carries the topology of |.| (the one-seminorm family of RR-NVS), as in functional-cont-iff-bound.
;;; Necessity: f^-1(R \ {0}) is the complement of the kernel.  Sufficiency (the notes' proof): with
;;; f(a) = eps and (a + V) missing the kernel, continuity of scalar multiplication at (0, 0) gives d > 0 and
;;; W with s.W inside V for |s| < d; on W' = { z : (2/d).z in W } every |f(z)| <= eps (else s = -eps / f(z)
;;; puts a + s.z in the kernel).  Translating W' to x0 gives continuity at x0.  Openness of such sets is
;;; by top-open-of-local (an open neighbourhood of every point inside the set).

(define (tkr-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; TKR OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (tkr-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (tkr-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (tkr-subst-rev! e) (subst (list '= (caddr e) (cadr e))))
(define (tkr-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((and (pair? t) (= (length t) 2) (eq? (car t) 'f)) (tkr-vtype! (cadr t))
           (dk-cite! 'fun-apply-type-c 'f '(VEC m) 'RR (cadr t)) ty)
          ((dk-head-is? t 'abs) (tkr-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (tkr-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3))
           (tkr-real! (cadr t)) (tkr-real! (caddr t)) (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((dk-head-is? t 'recip) (tkr-real! (cadr t))
           (tkr-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (dk-cite! 'rr-recip-closed (cadr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (tkr-real! (cadr t)) (tkr-real! (caddr t))
           (tkr-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-type! t) ty))))
(define (tkr-vtype! t)
  (let ((ty (list 'IN t '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((equal? t '(VZERO m)) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (tkr-real! (cadr t)) (tkr-vtype! (caddr t)) (dk-cite! 'rmod-act-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (tkr-vtype! (cadr t)) (tkr-vtype! (caddr t)) (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)) ty)
          (#t (error "tkr-vtype!: no typing for" t)))))

