;;; lp-complete.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/md/me-rf.scm.
;;; Library: measure.

;;; me-rf.scm -- THE RIESZ-FISCHER THEOREM: L^p (1 <= p < inf) is complete.
;;; Agent M-D (M-E targets), worker-02, 2026-10-28.  DESTINATION: theorem-library/lp-complete.scm.
;;; Library: measure.  Helper prefix: mrf-.
;;; Load window: after lp-convergence.scm (lp-dominated-convergence, md-lp.scm) and lp-step-dense.scm
;;; (nondecreasing-converges-to-esup, real-valued-measurable-fn-real, md-step.scm), integral-convergence.scm
;;; (monotone-convergence, measurable-fn-liminf, measurable-fn-finite-part), lp-inequalities.scm
;;; (integral-finite-ae-finite, EPOW), comparison-test-proof.scm / dominated-convergence.scm
;;; (SERIES-PARTIAL-SUM laws), seq-limit.scm (rr-cauchy-converges, rr-limit-sub).
;;;
;;; THE ROUTE (the textbook one).  A sequence g_k in L^p with ||g_{k+1} - g_k||_p <= rad(k), rad summable:
;;;   D_n(x) = sum_{k<n} |g_{k+1}(x) - g_k(x)|  (SERIES-PARTIAL-SUM), ||D_n||_p <= sum_{k<n} rad(k) <= C
;;;   by Minkowski (lp-norm-triangle); H = sup_n D_n^p has integral <= C^p by monotone convergence, so
;;;   H is finite off a null set N; off N the partial sums D_n(x) are bounded and nondecreasing, so
;;;   (telescoping) g_k(x) is Cauchy, hence so are its positive and negative parts; f is the difference
;;;   of the truncated liminfs of the parts (measurable), g_k(x) -> f(x) off N, |g_k| <= |g_0| + H^{1/p},
;;;   and Corollary 2.29 (lp-dominated-convergence) gives ||g_k - f||_p -> 0.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mrf-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MRF OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mrf-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (mrf-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (mrf-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mrf-tree-sub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (s) (mrf-tree-sub x y s)) t)) (#t t)))
(define (mrf-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mrf-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mrf-has-lam? (car l)) (loop (cdr l))))))))
(define (mrf-beta!) (if (mrf-has-lam? (dk-goal)) (dk-lam-b!)))
(define (mrf-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (mrf-pos-parts! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mrf-posrr! e)                 ; (IN e RR), (< 0 e) in context: (POS-RR e)
  (let ((g (list 'POS-RR e)))
    (if (not (dk-asm? g))
        (begin
          (dk-project! (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e))) (lambda () (mac-h '< (dk-ctx-form (list '< 0 e)))))
          (dk-split-all! (list (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e)))))
          (dk-have! g (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))))
    g))
(define (mrf-rps! t) (if (not (dk-asm? (list 'IN t 'RR-POS-STAR))) (dk-cite! 'rmc-rps-of-nonneg t)))
(define (mrf-mark! . xs)
  (let ((port (open-output-file "/tmp/mrf-trace.txt" #t)))
    (for-each (lambda (x) (write-string (if (string? x) x (expression->string x)) port) (write-string " " port)) xs)
    (newline port) (close-port port)))
(define (mrf-fun1! f cod)              ; (IN f (FUN omega cod)) in context: (IN f (FUN omega))
  (if (not (dk-asm? (list 'IN f '(FUN omega))))
      (let ((fi (dk-cite! 'fun-codomain-iff 'omega cod f)))
        (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN f (list 'FUN 'omega cod))) (prop))))
        (mrf-split! (caddr fi)))))
(define (mrf-funext! f g cf cg pt!)    ; f in FUN(omega, cf), g in FUN(omega, cg): PT! x proves (= (f x) (g x)); lands (= f g)
  (mrf-fun1! f cf) (mrf-fun1! g cg)
  (dk-have! (list 'FORALL 'mdtz_ (list 'IMPLIES '(IN mdtz_ omega) (list '= (list f 'mdtz_) (list g 'mdtz_))))
    (lambda () (let ((x (dk-di-var!))) (pt! x))))
  (dk-cite! 'fun-domain-extensionality 'omega f g))
(define (mrf-pos-of fs) (find-first (lambda (h) (dk-head-is? h 'POS-RR)) fs))

;;; the tail functoid unfolded, as a theorem (mac-h cannot unfold a functoid by its own name)
(sp (make-wff '(FORALL f (FORALL n (== (ETAIL f n) (IMAGE f (SEP p_ NN (<= n p_))))))))
(dk-peel!)
(mac 'ETAIL)
(qrfl)
(mrf-qed! 'etail-unfold)

;;; ===========================================================================
;;; (1) a convergent sequence of nonnegative reals: its lower limit in [0, +inf] is its limit
;;; ===========================================================================
(define mrf-cv '(FORALL eps (IMPLIES (POS-RR eps) (FORSOME n (AND (IN n NN) (FORALL n_ (IMPLIES (IN n_ NN) (IMPLIES (<= n n_) (<= ((DIST RR-MS) (u n_) l) eps)))))))))
(define mrf-h1 '(FORALL cpsk_ (IMPLIES (IN cpsk_ NN) (IN (u cpsk_) RR))))
(define mrf-h2 '(FORALL cpsk_ (IMPLIES (IN cpsk_ NN) (<= 0 (u cpsk_)))))
(sp (make-wff (mrf-alls '(u l) (mrf-imps '((IN u (FUN NN RR)) (FORALL k (IMPLIES (IN k NN) (<= 0 (u k)))) (IN l RR) (CONVERGES-TO RR-MS u l))
   '(AND (<= 0 l) (= (ELIMINF u) l))))))
(dk-peel!)
(fact 'nn-is-set)
(fact 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(mrf-rps! 0)
(define (mrf-uk! k)
  (dk-cite! 'fun-apply-type-c 'u 'NN 'RR k)
  (dk-apply! (dk-ctx-form '(FORALL k (IMPLIES (IN k NN) (<= 0 (u k))))) k)
  (mrf-rps! (list 'u k)))
(dk-have! mrf-h1 (lambda () (let ((k (dk-di-var!))) (mrf-uk! k) (dk-ass!))))
(dk-have! mrf-h2 (lambda () (let ((k (dk-di-var!))) (mrf-uk! k) (dk-ass!))))
(dk-project! mrf-cv 'converges-to '(CONVERGES-TO RR-MS u l))
;; the tail at eps: returns nb; lands, for the caller's k >= nb, nothing yet
(define (mrf-tail! c)
  (let* ((nb (dk-skolem! (dk-apply! (dk-ctx-form mrf-cv) c) #t)))
    nb))
(define (mrf-tail-at! c nb k)           ; k in NN, nb <= k in context: l - c <= u k <= l + c
  (let ((tl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nb) (dk-contains? h c))) "the tail")))
    (mrf-uk! k)
    (dk-apply! tl k)
    (dk-cite! 'rr-ms-dist (list 'u k) 'l)
    (let ((d (list '- (list 'u k) 'l)))
      (dk-type! d)
      (dk-rewrite-h! (list '<= (list '(DIST RR-MS) (list 'u k) 'l) c) (list '(DIST RR-MS) (list 'u k) 'l) (list 'abs d))
      (mrf-split! (dk-cite! 'rr-abs-le-parts d c)))))
;; (a) 0 <= l
(dk-have! '(<= 0 l)
  (lambda ()
    (pbc)
    (dk-cite! 'rr-not-le-lt 0 'l)
    (let ((c '(* -1/2 l)))
      (dk-have! (list 'IN c 'RR) (lambda () (dk-type! c)))
      (dk-have! (list '< 0 c) (lambda () (dk-ineq! '(IN l RR) '(< l 0))))
      (mrf-posrr! c)
      (let ((nb (mrf-tail! c)))
        (fact 'nn-le-refl nb)
        (mrf-tail-at! c nb nb)
        (dk-absurd! '(IN l RR) (list 'IN (list 'u nb) 'RR) (list '<= 0 (list 'u nb)) (list '<= (list '- (list 'u nb) 'l) c) '(< l 0))))))
;; (b) ELIMSUP u <= l + c for every positive c
(dk-cite! 'elimsup-in-rr-pos-star 'u)
(dk-cite! 'eliminf-in-rr-pos-star 'u)
(dk-have! '(IN u (FUN NN RR-POS-STAR))
  (lambda () (let ((fi (dk-cite! 'fun-codomain-iff 'NN 'RR-POS-STAR 'u)) (fr (dk-cite! 'fun-codomain-iff 'NN 'RR 'u)))
               (dk-have! (caddr fr) (lambda () (if (dk-only! fr '(IN u (FUN NN RR))) (prop))))
               (mrf-split! (caddr fr))
               (dk-have! '(FORALL x (IMPLIES (IN x NN) (IN (u x) RR-POS-STAR)))
                 (lambda () (let ((k (dk-di-var!))) (mrf-uk! k) (dk-ass!))))
               (mrf-and! '(IN u (FUN NN)) '(FORALL x (IMPLIES (IN x NN) (IN (u x) RR-POS-STAR))))
               (if (dk-only! fi (caddr fi)) (prop)))))
(dk-cite! 'eliminf-le-elimsup 'u)
(define mrf-es '(ELIMSUP u))
(define mrf-ei '(ELIMINF u))
(dk-have! (list 'FORALL 'c (list 'IMPLIES '(POS-RR c) (list '<= mrf-es '(+ l c))))
  (lambda ()
    (let* ((ld (dk-peel!)) (c (cadr (mrf-pos-of ld))))
      (mrf-pos-parts! c)
      (let ((nb (mrf-tail! c)) (r (list '+ 'l c)))
        (dk-have! (list 'IN r 'RR) (lambda () (dk-type! r)))
        (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IMPLIES (list '<= nb 'k_) (list '<= '(u k_) r))))
          (lambda () (let* ((ld2 (dk-peel!)) (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) ld2))))
                       (mrf-tail-at! c nb k)
                       (dk-ineq! '(IN l RR) (list 'IN (list 'u k) 'RR) (list 'IN c 'RR) (list '<= (list '- (list 'u k) 'l) c)))))
        (dk-cite! 'elimsup-eventually-le 'u)
        (dk-apply! (dk-ctx-form '(FORALL rtpr_ (IMPLIES (IN rtpr_ RR) (FORALL rtpn_ (IMPLIES (IN rtpn_ NN)
                                   (IMPLIES (FORALL k_ (IMPLIES (IN k_ NN) (IMPLIES (<= rtpn_ k_) (<= (u k_) rtpr_)))) (<= (ELIMSUP u) rtpr_)))))))
                   r nb)
        (dk-ass!)))))
;; (c) both limits are real
(fact 'nn-one-in)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(mrf-posrr! 1)
(dk-apply! (dk-ctx-form (list 'FORALL 'c (list 'IMPLIES '(POS-RR c) (list '<= mrf-es '(+ l c))))) 1)
(dk-have! '(IN (+ l 1) RR) (lambda () (dk-type! '(+ l 1))))
(dk-cite! 'rps-below-real-is-real mrf-es '(+ l 1))
(dk-cite! 'rr-pos-star-nonneg mrf-ei)
(dk-have! (list '<= mrf-ei '(+ l 1))
  (lambda () (mrf-rps! '(+ l 1))
             (dk-have! '(<= 0 (+ l 1)) (lambda () (dk-ineq! '(IN l RR) '(<= 0 l))))
             (mrf-rps! '(+ l 1))
             (mrf-and! (list 'IN mrf-ei 'RR-POS-STAR) (list 'IN mrf-es 'RR-POS-STAR) '(IN (+ l 1) RR-POS-STAR))
             (mrf-and! (list '<= mrf-ei mrf-es) (list '<= mrf-es '(+ l 1)))
             (dk-cite! 'rr-pos-star-le-trans mrf-ei mrf-es '(+ l 1))
             (dk-ass!)))
(dk-cite! 'rps-below-real-is-real mrf-ei '(+ l 1))
;; ELIMSUP u <= l
(dk-have! (list '<= mrf-es 'l)
  (lambda ()
    (pbc)
    (let ((c (list '* 1/2 (list '- mrf-es 'l))))
      (dk-have! (list 'IN c 'RR) (lambda () (dk-type! c)))
      (dk-cite! 'rr-not-le-lt mrf-es 'l)
      (dk-have! (list '< 0 c) (lambda () (dk-ineq! '(IN l RR) (list 'IN mrf-es 'RR) (list '< 'l mrf-es))))
      (mrf-posrr! c)
      (dk-apply! (dk-ctx-form (list 'FORALL 'c (list 'IMPLIES '(POS-RR c) (list '<= mrf-es '(+ l c))))) c)
      (dk-absurd! '(IN l RR) (list 'IN mrf-es 'RR) (list 'IN c 'RR) (list '< 'l mrf-es) (list '<= mrf-es (list '+ 'l c))))))
;; (d) l - c <= ELIMINF u for every positive c (trivial when l - c <= 0)
(define mrf-im '(IMAGE (VNB-LAMBDA n_ NN (EINF (ETAIL u n_))) NN))
(dk-have! (list '== mrf-ei (list 'ESUP mrf-im)) (lambda () (mac 'ELIMINF) (qrfl)))
(dk-cite! 'etail-subset-rr-pos-star 'u)
(dk-have! (list 'SUBSET mrf-im 'RR-POS-STAR)
  (lambda ()
    (mac 'subset-def)
    (let* ((w (dk-di-var!)) (ex (dk-image-hyp! (list 'IN w mrf-im))) (n (dk-skolem! ex #t)))
      (dk-apply! (dk-ctx-form '(FORALL cpsn_ (SUBSET (ETAIL u cpsn_) RR-POS-STAR))) n)
      (dk-cite! 'einf-in (list 'ETAIL 'u n))
      (let ((eq (dk-pick (lambda (h) (and (dk-head-is? h '=) (dk-contains? h w))) "the image value")))
        (dk-lam-b-h! eq)
        (subst (list '= w (list 'EINF (list 'ETAIL 'u n))))
        (dk-ass!)))))
(dk-have! (list 'FORALL 'c (list 'IMPLIES '(POS-RR c) (list '<= '(- l c) mrf-ei)))
  (lambda ()
    (let* ((ld (dk-peel!)) (c (cadr (mrf-pos-of ld))) (b (list '- 'l c)))
      (mrf-pos-parts! c)
      (dk-have! (list 'IN b 'RR) (lambda () (dk-type! b)))
      (use-em (list '<= b 0)
        (lambda () (dk-ineq! (list 'IN b 'RR) (list '<= b 0) (list 'IN mrf-ei 'RR) (list '<= 0 mrf-ei)))
        (lambda ()
          (dk-cite! 'rr-not-le-lt b 0)
          (dk-have! (list '<= 0 b) (lambda () (dk-ineq! (list 'IN b 'RR) (list '< 0 b))))
          (mrf-rps! b)
          (let* ((nb (mrf-tail! c)) (tl (list 'ETAIL 'u nb)) (ei (list 'EINF tl)))
            (dk-apply! (dk-ctx-form '(FORALL cpsn_ (SUBSET (ETAIL u cpsn_) RR-POS-STAR))) nb)
            (dk-cite! 'einf-in tl)
            (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ tl) (list '<= b 'cpsx_)))
              (lambda ()
                (let* ((w (dk-di-var!)))
                  (dk-cite! 'etail-unfold 'u nb)
                  (dk-rewrite-h! (list 'IN w tl) tl (list 'IMAGE 'u (list 'SEP 'p_ 'NN (list '<= nb 'p_))))
                  (let* ((ex (dk-image-hyp! (list 'IN w (list 'IMAGE 'u (list 'SEP 'p_ 'NN (list '<= nb 'p_))))))
                         (k (dk-skolem! ex #t))
                         (sm (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) k) (dk-head-is? (caddr h) 'SEP))) "the tail index")))
                    (sep-me sm)
                    (dk-split-all!)
                    (mrf-tail-at! c nb k)
                    (subst (list '= w (list 'u k)))
                    (dk-ineq! '(IN l RR) (list 'IN (list 'u k) 'RR) (list 'IN c 'RR) (list '<= (list '- 'c) (list '- (list 'u k) 'l)))))))
            (mrf-and! (list 'IN b 'RR-POS-STAR) (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ tl) (list '<= b 'cpsx_))))
            (dk-cite! 'einf-greatest tl b)
            ;; EINF(tail at nb) is in the image, so below the lower limit
            (dk-have! (list 'IN ei mrf-im)
              (lambda () (dk-image-goal!) (ew nb) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (mrf-beta!) (if (mrf-open?) (rfl))))))))
            (dk-cite! 'esup-upper mrf-im ei)
            (dk-have! (list '<= ei mrf-ei) (lambda () (subst (list '== mrf-ei (list 'ESUP mrf-im))) (dk-ass!)))
            (mrf-and! (list 'IN b 'RR-POS-STAR) (list 'IN ei 'RR-POS-STAR) (list 'IN mrf-ei 'RR-POS-STAR))
            (mrf-and! (list '<= b ei) (list '<= ei mrf-ei))
            (dk-cite! 'rr-pos-star-le-trans b ei mrf-ei)
            (dk-ass!)))))))
;; (e) ELIMINF u = l
(dk-have! (list '= mrf-ei 'l)
  (lambda ()
    (pbc)
    (dk-have! (list '< mrf-ei 'l)
      (lambda () (mac '<) (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! (list 'IN mrf-ei 'RR) (list 'IN mrf-es 'RR) '(IN l RR) (list '<= mrf-ei mrf-es) (list '<= mrf-es 'l)))))))
    (let ((c (list '* 1/2 (list '- 'l mrf-ei))))
      (dk-have! (list 'IN c 'RR) (lambda () (dk-type! c)))
      (dk-have! (list '< 0 c) (lambda () (dk-ineq! '(IN l RR) (list 'IN mrf-ei 'RR) (list '< mrf-ei 'l))))
      (mrf-posrr! c)
      (dk-apply! (dk-ctx-form (list 'FORALL 'c (list 'IMPLIES '(POS-RR c) (list '<= '(- l c) mrf-ei)))) c)
      (dk-absurd! '(IN l RR) (list 'IN mrf-ei 'RR) (list '< mrf-ei 'l) (list '<= (list '- 'l c) mrf-ei)))))
(dk-conj-close! (lambda () (dk-ass!)))
(mrf-qed! 'rr-converges-nonneg-eliminf)

;;; ===========================================================================
;;; (2) the finite part of a measurable [0, +inf]-valued function is a measurable real function
;;;     TR(h) = 1_{h < inf} . h   (0 . inf = 0)
;;; ===========================================================================
(define mrf-fin '(SEP fp_ omega (IN (h fp_) RR)))
(define mrf-I (list 'INDICATOR 'omega mrf-fin))
(define mrf-TR (list 'PTWISE-ETIMES 'omega mrf-I 'h))
(define (mrf-rps-case! t)              ; t in RPS, not real: (= t POS-INF)
  (let ((mi (dk-cite! 'rr-pos-star-membership t)))
    (dk-have! (caddr mi) (lambda () (if (dk-only! mi (list 'IN t 'RR-POS-STAR)) (prop))))
    (dk-have! (list '= t 'POS-INF) (lambda () (if (dk-only! (caddr mi) (list 'NOT (list 'IN t 'RR))) (prop))))))
(sp (make-wff (mrf-alls '(omega ca h) (mrf-imps '((IS-MEASURABLE-FN omega ca h))
   (list 'AND (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mrf-TR)
     (list 'AND (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES '(IN (h x) RR) (list '= (list mrf-TR 'x) '(h x)))))
                (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES '(NOT (IN (h x) RR)) (list '= (list mrf-TR 'x) 0))))))))))
(dk-peel!)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca h))
(dk-project! '(IN h (FUN omega RR-POS-STAR)) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca h))
(dk-cite! 'measurable-fn-finite-part 'omega 'ca 'h)
(dk-cite! 'measurable-fn-indicator 'omega 'ca mrf-fin)
(dk-cite! 'measurable-fn-etimes 'omega 'ca mrf-I 'h)
(dk-project! (list 'IN mrf-I '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca mrf-I))
(dk-project! (list 'IN mrf-TR '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca mrf-TR))
(fact 'rr-zero-in)
(fact 'nn-one-in)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(define (mrf-tr-at! x)                 ; lands (= (TR x) (etimes (I x) (h x)))
  (dk-cite! 'fun-apply-type-c 'h 'omega 'RR-POS-STAR x)
  (dk-cite! 'fun-apply-type-c mrf-I 'omega 'RR-POS-STAR x)
  (dk-cite! 'ptwise-etimes-value 'omega mrf-I 'h x))
(define mrf-tr-in (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES '(IN (h x) RR) (list '= (list mrf-TR 'x) '(h x))))))
(define mrf-tr-out (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES '(NOT (IN (h x) RR)) (list '= (list mrf-TR 'x) 0)))))
(dk-have! mrf-tr-in
  (lambda ()
    (let* ((ld (dk-peel!)) (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'omega))) ld))))
      (mrf-tr-at! x)
      (dk-have! (list 'IN x mrf-fin) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
      (dk-cite! 'indicator-value-in 'omega mrf-fin x)
      (dk-cite! 'etimes-one-left (list 'h x))
      (subst (list '= (list mrf-TR x) (list 'etimes (list mrf-I x) (list 'h x))))
      (subst (list '= (list mrf-I x) 1))
      (dk-ass!))))
(dk-have! mrf-tr-out
  (lambda ()
    (let* ((ld (dk-peel!)) (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'omega))) ld))))
      (mrf-tr-at! x)
      (dk-have! (list 'NOT (list 'IN x mrf-fin))
        (lambda () (di)
                   (let ((m (dk-ctx-form (list 'IN x mrf-fin))))
                     (sep-me m) (dk-split-all!)
                     (ai (list 'NOT (list 'IN (list 'h x) 'RR))))))
      (dk-cite! 'indicator-value-out 'omega mrf-fin x)
      (mrf-rps-case! (list 'h x))
      (dk-cite! 'etimes-zero-pos-inf)
      (subst (list '= (list mrf-TR x) (list 'etimes (list mrf-I x) (list 'h x))))
      (subst (list '= (list mrf-I x) 0))
      (subst (list '= (list 'h x) 'POS-INF))
      (dk-ass!))))
(dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list 'IN (list mrf-TR 'x_) 'RR)))
  (lambda ()
    (let ((x (dk-di-var!)))
      (use-em (list 'IN (list 'h x) 'RR)
        (lambda () (dk-apply! (dk-ctx-form mrf-tr-in) x) (subst (list '= (list mrf-TR x) (list 'h x))) (dk-ass!))
        (lambda () (dk-apply! (dk-ctx-form mrf-tr-out) x) (subst (list '= (list mrf-TR x) 0)) (dk-ass!))))))
(dk-cite! 'real-valued-measurable-fn-real 'omega 'ca mrf-TR)
(dk-conj-close! (lambda () (dk-ass!)))
(mrf-qed! 'finite-part-real-measurable)

;;; the positive and negative parts are 1-Lipschitz, pointwise
(define (mrf-pp f x) (list (list 'POS-PART 'omega f) x))
(define (mrf-np f x) (list (list 'NEG-PART 'omega f) x))
(sp (make-wff (mrf-alls '(omega f g x) (mrf-imps '((IN f (FUN omega RR)) (IN g (FUN omega RR)) (IN x omega))
   (list 'AND (list '<= (list 'abs (list '- (mrf-pp 'f 'x) (mrf-pp 'g 'x))) '(abs (- (f x) (g x))))
              (list '<= (list 'abs (list '- (mrf-np 'f 'x) (mrf-np 'g 'x))) '(abs (- (f x) (g x)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'part-values-at 'omega 'f 'x)))
(dk-split-all! (list (dk-cite! 'part-values-at 'omega 'g 'x)))
(dk-cite! 'fun-apply-type-c 'f 'omega 'RR 'x)
(dk-cite! 'fun-apply-type-c 'g 'omega 'RR 'x)
(let* ((a '(f x)) (b '(g x)) (aa '(abs (f x))) (ab '(abs (g x))) (d '(- (f x) (g x))) (ad '(abs (- (f x) (g x))))
       (r (list '- aa ab)) (ar (list 'abs r)))
  (dk-cite! 'rr-abs-closed a) (dk-cite! 'rr-abs-closed b)
  (dk-type! d) (dk-cite! 'rr-abs-closed d)
  (dk-type! r) (dk-cite! 'rr-abs-closed r)
  (dk-cite! 'rr-abs-reverse-triangle a b)
  (mrf-split! (dk-cite! 'rr-abs-le-parts r ad))
  (dk-cite! 'rr-le-abs d) (dk-cite! 'rr-neg-abs-le d)
  (let ((prems (list (list 'IN a 'RR) (list 'IN b 'RR) (list 'IN aa 'RR) (list 'IN ab 'RR) (list 'IN ad 'RR)
                     (list 'IN (mrf-pp 'f 'x) 'RR) (list 'IN (mrf-np 'f 'x) 'RR) (list 'IN (mrf-pp 'g 'x) 'RR) (list 'IN (mrf-np 'g 'x) 'RR)
                     (list '= a (list '- (mrf-pp 'f 'x) (mrf-np 'f 'x))) (list '= aa (list '+ (mrf-pp 'f 'x) (mrf-np 'f 'x)))
                     (list '= b (list '- (mrf-pp 'g 'x) (mrf-np 'g 'x))) (list '= ab (list '+ (mrf-pp 'g 'x) (mrf-np 'g 'x)))
                     (list '<= (list '- ad) r) (list '<= r ad) (list '<= d ad) (list '<= (list '- ad) d))))
    (for-each
      (lambda (pf)
        (let ((e (list '- (pf 'f 'x) (pf 'g 'x))))
          (dk-type! e)
          (dk-have! (list '<= (list '- ad) e) (lambda () (apply dk-ineq! prems)))
          (dk-have! (list '<= e ad) (lambda () (apply dk-ineq! prems)))
          (dk-cite! 'rr-abs-le-of-parts e ad)))
      (list mrf-pp mrf-np))
    (dk-conj-close! (lambda () (dk-ass!)))))
(mrf-qed! 'parts-lipschitz)

;;; ===========================================================================
;;; (3) telescoping: |g_m(x) - g_n(x)| <= D_m(x) - D_n(x) for n <= m
;;;     D_n(x) = SERIES-PARTIAL-SUM(k |-> |g_{k+1}(x) - g_k(x)|, n)
;;; ===========================================================================
(define (mrf-w x) (list 'VNB-LAMBDA 'rdk_ 'NN (list 'abs (list '- (list '(gs (succ rdk_)) x) (list '(gs rdk_) x)))))
(define (mrf-S x n) (list 'SERIES-PARTIAL-SUM (mrf-w x) n))
(define (mrf-v k x) (list (list 'gs k) x))
(define (mrf-gk! k x)                  ; gs(k) a real function; its value at x real
  (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) k)
  (dk-cite! 'fun-apply-type-c (list 'gs k) 'omega 'RR x))
(define (mrf-wk! x k)                  ; k in NN: (w k) = |g_{k+1} x - g_k x|, real, nonneg; returns the abs term
  (fact 'nn-succ-closed k)
  (mrf-gk! k x) (mrf-gk! (list 'succ k) x)
  (let* ((d (list '- (mrf-v (list 'succ k) x) (mrf-v k x))) (ad (list 'abs d)) (e (list '= (list (mrf-w x) k) ad)))
    (dk-type! d) (dk-cite! 'rr-abs-closed d) (dk-cite! 'rr-abs-nonneg d)
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mrf-beta!) (if (mrf-open?) (rfl)))))
    (if (not (dk-asm? (list 'IN (list (mrf-w x) k) 'RR)))
        (dk-have! (list 'IN (list (mrf-w x) k) 'RR) (lambda () (subst e) (dk-ass!))))
    ad))
(define (mrf-w-typed! x)               ; (IN w (FUN NN RR)) and pointwise nonneg
  (let ((w (mrf-w x)))
    (if (not (dk-asm? (list 'IN w '(FUN NN RR))))
        (begin
          (fact 'nn-is-set)
          (dk-have! (list 'IN w '(FUN NN RR))
            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mrf-wk! x k) (dk-ass!))) (lambda () (dk-ass!)))))
          (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ NN) (list '<= 0 (list w 'i_))))
            (lambda () (let ((k (dk-di-var!))) (let ((ad (mrf-wk! x k))) (subst (list '= (list w k) ad)) (dk-ass!)))))))))
(define (mrf-S! x n) (mrf-w-typed! x) (dk-cite! 'series-partial-sum-in-rr n (mrf-w x)))
(define (mrf-tele-concl x) (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IMPLIES '(<= n_ m)
   (list '<= (list 'abs (list '- (mrf-v 'm x) (mrf-v 'n_ x))) (list '- (mrf-S x 'm) (mrf-S x 'n_)))))))))
(sp (make-wff (mrf-alls '(omega gs x) (mrf-imps '((IN gs (FUN NN (FUN omega RR))) (IN x omega)) (mrf-tele-concl 'x)))))
(di) (di) (di)
(fact 'rr-zero-in)
(define (mrf-same! k)                  ; goal |g_k x - g_k x| <= S_k - S_k
  (mrf-gk! k 'x) (mrf-S! 'x k)
  (let ((y (mrf-v k 'x)))
    (dk-have! (list '= (list '- y y) 0) (lambda () (crs)))
    (subst (list '= (list '- y y) 0))
    (dk-cite! 'rr-abs-zero-value)
    (subst '(= (abs 0) 0))
    (dk-ineq! (list 'IN (mrf-S 'x k) 'RR))))
(let* ((br (use-induction)) (m (cdr (assq 'var br))) (ih (cdr (assq 'ih br))))
  (dk-focus! (cdr (assq 'base br)))
  (let* ((ld (dk-peel!)) (n (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) ld))))
    (fact 'nn-zero-in)
    (dk-cite! 'nn-le-zero-is-zero n)
    (subst (list '= n 0))
    (mrf-same! 0))
  (dk-focus! (cdr (assq 'step br)))
  (let* ((ld (dk-peel!)) (n (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN) (not (eq? (cadr h) m)))) ld))))
    (fact 'nn-succ-closed m)
    (let ((dj (dk-cite! 'nn-le-succ-cases m n)))
      (use-cases dj
        (lambda ()
          (dk-apply! ih n)
          (let* ((sm (list 'succ m))
                 (a1 (list '- (mrf-v sm 'x) (mrf-v m 'x))) (a2 (list '- (mrf-v m 'x) (mrf-v n 'x)))
                 (tgt (list '- (mrf-v sm 'x) (mrf-v n 'x))))
            (mrf-gk! n 'x)
            (let ((wm (mrf-wk! 'x m)))
              (dk-type! a2) (dk-type! tgt)
              (mrf-and! (list 'IN a1 'RR) (list 'IN a2 'RR))
              (let ((tri (dk-cite! 'rr-abs-triangle a1 a2)))
                (dk-have! (list '= (list '+ a1 a2) tgt) (lambda () (crs)))
                (dk-rewrite-h! tri (list '+ a1 a2) tgt))
              (mrf-S! 'x m) (mrf-S! 'x n)
              (let ((ss (dk-cite! 'series-partial-sum-succ (mrf-w 'x) m)))
                (subst ss)
                (subst (list '= (list (mrf-w 'x) m) wm))
                (dk-cite! 'rr-abs-closed a2) (dk-cite! 'rr-abs-closed tgt)
                (dk-ineq! (list 'IN (mrf-S 'x m) 'RR) (list 'IN (mrf-S 'x n) 'RR) (list 'IN wm 'RR) (list 'IN (list 'abs a2) 'RR) (list 'IN (list 'abs tgt) 'RR)
                          (list '<= (list 'abs tgt) (list '+ wm (list 'abs a2)))
                          (list '<= (list 'abs a2) (list '- (mrf-S 'x m) (mrf-S 'x n))))))))
        (lambda ()
          (subst (list '= n (list 'succ m)))
          (mrf-same! (list 'succ m)))))))
(mrf-qed! 'partial-sum-telescope)

;;; the partial sums at a point are nonnegative reals
(define (mrf-psr x) (list 'AND (list 'IN (mrf-w x) '(FUN NN RR))
                          (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list 'IN (mrf-S x 'n) 'RR) (list '<= 0 (mrf-S x 'n)))))))
(sp (make-wff (mrf-alls '(omega gs) (mrf-imps '((IN gs (FUN NN (FUN omega RR)))) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (mrf-psr 'x)))))))
(let* ((ld (dk-peel!)) (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'omega))) ld))))
  (mrf-w-typed! x)
  (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list 'IN (mrf-S x 'n) 'RR) (list '<= 0 (mrf-S x 'n)))))
    (lambda () (let ((n (dk-di-var!)))
                 (dk-cite! 'series-partial-sum-in-rr n (mrf-w x))
                 (dk-cite! 'series-partial-sum-nonneg n (mrf-w x))
                 (dk-conj-close! (lambda () (dk-ass!))))))
  (dk-conj-close! (lambda () (dk-ass!))))
(mrf-qed! 'partial-sum-real)
(define (mrf-S! x n)
  (if (not (dk-asm? (list 'IN (mrf-S x n) 'RR)))
      (let ((c (dk-cite! 'partial-sum-real 'omega 'gs x)))
        (mrf-split! c)
        (mrf-split! (dk-apply! (dk-ctx-form (caddr c)) n)))))

;;; ===========================================================================
;;; (4) the partial sums as functions: D_n is a measurable real function and ||D_n||_p <= sum_{k<n} rad(k)
;;; ===========================================================================
(define (mrf-dsum n) (list 'VNB-LAMBDA 'rdx_ 'omega (mrf-S 'rdx_ n)))
(define (mrf-dif k) (list 'VNB-LAMBDA 'sx_ 'omega (list '- (list (list 'gs (list 'succ k)) 'sx_) (list (list 'gs k) 'sx_))))
(define (mrf-A k) (list 'ABS-FN 'omega (mrf-dif k)))
(define (mrf-E n) (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list (mrf-dsum n) 'sx_) (list (mrf-A n) 'sx_))))
(define (mrf-LP h) (list 'LP-NORM 'omega 'ca 'mu 'p h))
(define mrf-gsm '(FORALL k (IMPLIES (IN k NN) (IS-REAL-MEASURABLE-FN omega ca (gs k)))))
(define mrf-H (list '(IS-MEASURE omega ca mu) '(IN gs (FUN NN (FUN omega RR))) mrf-gsm))
(define (mrf-setup!)
  (fact 'nn-is-set) (fact 'rr-zero-in) (fact 'nn-zero-in)
  (dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca))
(define (mrf-Dx! n x)                  ; x in omega: (= ((D n) x) (S x n)), S real; returns S
  (mrf-S! x n)
  (let ((e (list '= (list (mrf-dsum n) x) (mrf-S x n))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mrf-beta!) (if (mrf-open?) (rfl)))))
    (mrf-S x n)))
(define (mrf-D-fun! n)                 ; (IN (D n) (FUN omega RR))
  (let ((t (list 'IN (mrf-dsum n) '(FUN omega RR))))
    (if (not (dk-asm? t))
        (dk-have! t (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (mrf-S! x n) (dk-ass!))) (lambda () (dk-ass!))))))))
(define (mrf-dk! k)                    ; d_k real measurable, |d_k| real measurable; typings
  (fact 'nn-succ-closed k)
  (dk-apply! (dk-ctx-form mrf-gsm) k)
  (dk-apply! (dk-ctx-form mrf-gsm) (list 'succ k))
  (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) k)
  (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) (list 'succ k))
  (if (not (dk-asm? (list 'IN (mrf-dif k) '(FUN omega RR))))
      (dk-have! (list 'IN (mrf-dif k) '(FUN omega RR))
        (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (mrf-gk! k x) (mrf-gk! (list 'succ k) x) (dk-type! (cadr (dk-goal))) (dk-ass!)))
                                 (lambda () (dk-ass!))))))
  (dk-cite! 'real-measurable-sub 'omega 'ca (list 'gs (list 'succ k)) (list 'gs k))
  (dk-cite! 'abs-fn-real-measurable 'omega 'ca 'mu (mrf-dif k))
  (dk-project! (list 'IN (mrf-A k) '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (mrf-A k))))
;; E_n(x) = D_{n+1}(x)
(define (mrf-step-pt! n x)             ; goal (= ((E n) x) ((D (succ n)) x)), x in omega, n in NN
  (let ((ad (mrf-wk! x n)))
    (mrf-S! x n) (mrf-S! x (list 'succ n))
    (dk-cite! 'abs-fn-value 'omega (mrf-dif n) x)
    (mrf-beta!)
    (if (mrf-open?)
        (begin
          (subst (list '== (list (mrf-A n) x) (list 'abs (list (mrf-dif n) x))))
          (mrf-beta!)
          (if (mrf-open?)
              (begin
                (subst (dk-cite! 'series-partial-sum-succ (mrf-w x) n))
                (subst (list '= (list (mrf-w x) n) ad))
                (if (mrf-open?) (rfl))))))))
(define (mrf-E-eq! n)                  ; (= (E n) (D (succ n)))
  (let ((e (list '= (mrf-E n) (mrf-dsum (list 'succ n)))))
    (if (not (dk-asm? e))
        (begin
          (fact 'nn-succ-closed n)
          (mrf-D-fun! n) (mrf-D-fun! (list 'succ n)) (mrf-dk! n)
          (dk-have! (list 'IN (mrf-E n) '(FUN omega RR))
            (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                                  (mrf-Dx! n x) (dk-cite! 'fun-apply-type-c (mrf-A n) 'omega 'RR x)
                                                  (mrf-beta!) (dk-type! (cadr (dk-goal))) (dk-ass!)))
                                     (lambda () (dk-ass!)))))
          (mrf-funext! (mrf-E n) (mrf-dsum (list 'succ n)) 'RR 'RR (lambda (x) (mrf-step-pt! n x)))))
    e))
(define mrf-Dm '(FORALL n (IMPLIES (IN n NN) (IS-REAL-MEASURABLE-FN omega ca (VNB-LAMBDA rdx_ omega (SERIES-PARTIAL-SUM (VNB-LAMBDA rdk_ NN (abs (- ((gs (succ rdk_)) rdx_) ((gs rdk_) rdx_)))) n))))))
(sp (make-wff (mrf-alls '(omega ca mu gs) (mrf-imps mrf-H mrf-Dm))))
(di) (di) (di) (di)
(mrf-setup!)
(let* ((br (use-induction)) (n (cdr (assq 'var br))))
  (dk-focus! (cdr (assq 'base br)))
  (let ((z '(VNB-LAMBDA cx_ omega 0)))
    (dk-cite! 'real-measurable-const 'omega 'ca 0)
    (dk-project! (list 'IN z '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca z))
    (mrf-D-fun! 0)
    (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list z 'ex_) (list (mrf-dsum 0) 'ex_))))
      (lambda () (let ((x (dk-di-var!)))
                   (mrf-Dx! 0 x)
                   (dk-cite! 'series-partial-sum-zero (mrf-w x))
                   (mrf-beta!)
                   (if (mrf-open?) (begin (subst (list '== (mrf-S x 0) 0)) (if (mrf-open?) (rfl)))))))
    (dk-cite! 'real-measurable-ptwise-eq 'omega 'ca z (mrf-dsum 0))
    (dk-ass!))
  (dk-focus! (cdr (assq 'step br)))
  (mrf-dk! n)
  (dk-cite! 'real-measurable-add 'omega 'ca (mrf-dsum n) (mrf-A n))
  (mrf-E-eq! n)
  (subst (list '= (mrf-dsum (list 'succ n)) (mrf-E n)))
  (dk-ass!))
(mrf-qed! 'partial-sum-fn-measurable)

;;; ---------------------------------------------------------------------------
;;; ||D_n||_p <= rad(0) + ... + rad(n-1)
;;; ---------------------------------------------------------------------------
(define (mrf-dsum-fun! n) (mrf-D-fun! n))
(define (mrf-dk-real-E! n a b)         ; (IN (LP (E n)) RR) from (<= (LP (E n)) (+ a b)), a b real
  (let ((le (list 'IN (mrf-LP (mrf-E n)) 'RR)))
    (if (not (dk-asm? le))
        (begin
          (dk-cite! 'real-measurable-add 'omega 'ca (mrf-dsum n) (mrf-A n))
          (mrf-lp-rps! (mrf-E n))
          (dk-have! (list 'IN (list '+ a b) 'RR) (lambda () (dk-type! (list '+ a b))))
          (dk-cite! 'rps-below-real-is-real (mrf-LP (mrf-E n)) (list '+ a b))))))
(define (mrf-recip-p!)
  (if (not (dk-asm? '(IN (recip p) RR)))
      (begin
        (if (not (dk-asm? '(< 0 p))) (dk-have! '(< 0 p) (lambda () (dk-ineq! '(IN p RR) '(<= 1 p)))))
        (dk-have! '(NOT (= p 0)) (lambda () (di) (dk-absurd! '(IN p RR) '(= p 0) '(< 0 p))))
        (mrf-and! '(IN p RR) '(NOT (= p 0)))
        (dk-cite! 'rr-recip-closed 'p)
        (dk-cite! 'rr-recip-pos 'p))))
(define (mrf-I h) (list 'INTEGRAL 'omega 'ca 'mu (list 'PTWISE-EPOW 'omega (list 'ABS-FN 'omega h) 'p)))
(define (mrf-lp-rps! h)                ; h real measurable in context: (IN (LP h) RPS), and the integral facts
  (if (not (dk-asm? (list 'IN (mrf-LP h) 'RR-POS-STAR)))
      (begin
        (mrf-recip-p!)
        (mrf-split! (dk-cite! 'integral-abs-fn 'omega 'ca 'mu h))
        (dk-cite! 'measurable-fn-epow 'omega 'ca (list 'ABS-FN 'omega h) 'p)
        (dk-cite! 'integral-in 'omega 'ca 'mu (list 'PTWISE-EPOW 'omega (list 'ABS-FN 'omega h) 'p))
        (dk-cite! 'epow-in (mrf-I h) '(recip p))
        (let ((e (dk-cite! 'lp-norm-as-epow 'omega 'ca 'mu 'p h)))
          (dk-have! (list 'IN (mrf-LP h) 'RR-POS-STAR) (lambda () (subst e) (dk-ass!)))))))
(define (mrf-real-of-le! t b)          ; t in RPS, b real, (<= t b) in context: (IN t RR), (<= 0 t)
  (if (not (dk-asm? (list 'IN t 'RR))) (dk-cite! 'rps-below-real-is-real t b))
  (dk-cite! 'rr-pos-star-nonneg t))
(define (mrf-abs-abs! k)               ; (= (LP (ABS-FN (dif k))) (LP (dif k)))
  (let* ((a (mrf-A k)) (aa (list 'ABS-FN 'omega a)))
    (dk-have! (list 'IN aa '(FUN omega RR))
      (lambda () (dk-cite! 'abs-fn-real-measurable 'omega 'ca 'mu a)
                 (dk-project! (list 'IN aa '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca aa))))
    (mrf-funext! aa a 'RR 'RR
      (lambda (x)
        (dk-cite! 'fun-apply-type-c a 'omega 'RR x)
        (dk-cite! 'abs-fn-value 'omega a x)
        (dk-cite! 'fun-apply-type-c (mrf-dif k) 'omega 'RR x)
        (dk-cite! 'rr-abs-nonneg (list (mrf-dif k) x))
        (dk-cite! 'abs-fn-value 'omega (mrf-dif k) x)
        (dk-cite! 'rr-abs-closed (list (mrf-dif k) x))
        (dk-have! (list '<= 0 (list a x)) (lambda () (subst (list '== (list a x) (list 'abs (list (mrf-dif k) x)))) (dk-ass!)))
        (dk-cite! 'rr-abs-of-nonneg (list a x))
        (subst (list '== (list aa x) (list 'abs (list a x))))
        (dk-ass!)))
    (let ((u1 (dk-cite! 'lp-norm-unfold 'omega 'ca 'mu 'p a)) (u2 (dk-cite! 'lp-norm-unfold 'omega 'ca 'mu 'p (mrf-dif k))))
      (dk-have! (list '= (mrf-LP a) (mrf-LP (mrf-dif k)))
        (lambda () (subst u1) (subst u2) (subst (list '= aa a)) (if (mrf-open?) (rfl)))))))
(define mrf-radh '(FORALL k (IMPLIES (IN k NN) (<= (LP-NORM omega ca mu p (VNB-LAMBDA sx_ omega (- ((gs (succ k)) sx_) ((gs k) sx_)))) (rad k)))))
(define mrf-lpb (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mrf-LP (mrf-dsum 'n)) '(SERIES-PARTIAL-SUM rad n)))))
(sp (make-wff (mrf-alls '(omega ca mu gs p rad) (mrf-imps (append mrf-H (list '(IN p RR) '(<= 1 p) '(IN rad (FUN NN RR)) mrf-radh)) mrf-lpb))))
(di) (di) (di) (di) (di) (di) (di) (di)
(mrf-setup!)
(mrf-recip-p!)
(dk-cite! 'partial-sum-fn-measurable 'omega 'ca 'mu 'gs)
(define (mrf-Dm! n) (dk-apply! (dk-ctx-form mrf-Dm) n))
(let* ((br (use-induction)) (n (cdr (assq 'var br))))
  (dk-focus! (cdr (assq 'base br)))
