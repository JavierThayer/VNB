        (dk-project! (list 'IN ad '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca ad))
        (dk-project! (list 'IN (mrf-En n) '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca (mrf-En n))))))
(define (mrf-En-val! n x)              ; x in omega: (= ((E_n) x) (EPOW S p)), EPOW S p real nonneg; returns EPOW S p
  (mrf-En-facts! n)
  (let* ((s (mrf-Dx! n x)) (ad (list 'ABS-FN 'omega (mrf-dsum n))) (v (list 'EPOW s 'p)) (e (list '= (list (mrf-En n) x) v)))
    (if (not (dk-asm? e))
        (begin
          (dk-cite! 'ptwise-epow-value 'omega ad 'p x)
          (dk-cite! 'abs-fn-value 'omega (mrf-dsum n) x)
          (dk-cite! 'rr-abs-of-nonneg s)
          (mrf-split! (dk-apply! (dk-cite! 'epow-real-in s) 'p))
