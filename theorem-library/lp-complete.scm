  (lambda () (let ((k (dk-di-var!))) (mrf-ak! k) (dk-ass!))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list mrf-av 'k) (list mrf-av '(succ k)))))
  (lambda () (let ((k (dk-di-var!)))
               (fact 'nn-succ-closed k)
               (mrf-ak! k) (mrf-ak! (list 'succ k))
               (mrf-w-typed! 'xq)
               (let ((nf (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ NN) (list '<= 0 (list (mrf-w 'xq) 'i_))))))
                 (if (not (dk-asm? nf))
                     (dk-have! nf (lambda () (let ((j (dk-di-var!))) (let ((ad (mrf-wk! 'xq j))) (subst (list '= (list (mrf-w 'xq) j) ad)) (dk-ass!)))))))
               (dk-cite! 'nn-le-succ k)
               (dk-cite! 'series-partial-sum-mono (list 'succ k) k (mrf-w 'xq))
               (subst (list '= (list mrf-av k) (mrf-S 'xq k)))
               (subst (list '= (list mrf-av (list 'succ k)) (mrf-S 'xq (list 'succ k))))
               (dk-ass!))))
(define mrf-ai (list 'IMAGE mrf-av 'NN))
(define mrf-l (list 'ESUP mrf-ai))
(dk-have! '(<= 0 bb) (lambda () (mrf-ak! 0) (dk-apply! (dk-ctx-form (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mrf-S 'xq 'n) 'bb)))) 0)
                                (dk-ineq! (list 'IN (mrf-S 'xq 0) 'RR) '(IN bb RR) (list '<= 0 (mrf-S 'xq 0)) (list '<= (mrf-S 'xq 0) 'bb))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list mrf-av 'k) 'bb)))
  (lambda () (let ((k (dk-di-var!)))
               (mrf-ak! k)
               (dk-apply! (dk-ctx-form (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mrf-S 'xq 'n) 'bb)))) k)
               (subst (list '= (list mrf-av k) (mrf-S 'xq k)))
               (dk-ass!))))
(mrf-split! (dk-cite! 'bounded-nondecreasing-converges mrf-av 'bb))
(define mrf-acv (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'n (list 'AND '(IN n NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IMPLIES '(<= n n_) (list '<= (list '(DIST RR-MS) (list mrf-av 'n_) mrf-l) 'eps)))))))))
(dk-project! mrf-acv 'converges-to (list 'CONVERGES-TO 'RR-MS mrf-av mrf-l))
(let* ((ld (begin (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)) (dk-asms))) (eps (cadr (mrf-pos-of ld))) (h (list '* 1/2 eps)))
  (mrf-pos-parts! eps)
  (dk-have! (list 'IN h 'RR) (lambda () (dk-type! h)))
  (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list 'IN eps 'RR) (list '< 0 eps))))
  (mrf-posrr! h)
  (let* ((nb (dk-skolem! (dk-apply! (dk-ctx-form mrf-acv) h) #t))
         (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f h))) "the tail")))
    (ew nb)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((ld2 (dk-peel!))
                   (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld2))
                   (m (cadr (car ins))) (q (cadr (cadr ins))))
              (define (near! k)        ; |a k - l| <= h, a k = S x k
                (mrf-ak! k)
                (dk-apply! tl k)
                (dk-cite! 'rr-ms-dist (list mrf-av k) mrf-l)
                (let ((d (list '- (list mrf-av k) mrf-l)))
                  (dk-type! d)
                  (dk-rewrite-h! (list '<= (list '(DIST RR-MS) (list mrf-av k) mrf-l) h) (list '(DIST RR-MS) (list mrf-av k) mrf-l) (list 'abs d))
                  (mrf-split! (dk-cite! 'rr-abs-le-parts d h))))
              (near! m) (near! q)
              (mrf-gk! m 'xq) (mrf-gk! q 'xq)
              (dk-cite! 'nn-in-rr m) (dk-cite! 'nn-in-rr q)
              (let* ((gm (mrf-v m 'xq)) (gq (mrf-v q 'xq)) (d1 (list '- gm gq)) (d2 (list '- gq gm))
                     (base (list (list 'IN mrf-l 'RR) (list 'IN h 'RR) (list 'IN (mrf-S 'xq m) 'RR) (list 'IN (mrf-S 'xq q) 'RR)
                                 (list 'IN (list mrf-av m) 'RR) (list 'IN (list mrf-av q) 'RR)
                                 (list '= (list mrf-av m) (mrf-S 'xq m)) (list '= (list mrf-av q) (mrf-S 'xq q))
                                 (list '<= (list '- h) (list '- (list mrf-av m) mrf-l)) (list '<= (list '- (list mrf-av m) mrf-l) h)
                                 (list '<= (list '- h) (list '- (list mrf-av q) mrf-l)) (list '<= (list '- (list mrf-av q) mrf-l) h))))
                (dk-type! d1) (dk-type! d2) (dk-cite! 'rr-abs-closed d1) (dk-cite! 'rr-abs-closed d2)
                (dk-cite! 'partial-sum-telescope 'omega 'gs 'xq)
                (use-em (list '<= q m)
                  (lambda ()
                    (dk-apply! (dk-ctx-form (mrf-tele-concl 'xq)) m q)
                    (apply dk-ineq! (append base (list (list 'IN (list 'abs d1) 'RR) (list '<= (list 'abs d1) (list '- (mrf-S 'xq m) (mrf-S 'xq q)))))))
                  (lambda ()
                    (dk-cite! 'rr-not-le-lt q m)
                    (dk-have! (list '<= m q) (lambda () (dk-ineq! (list 'IN m 'RR) (list 'IN q 'RR) (list '< m q))))
                    (dk-apply! (dk-ctx-form (mrf-tele-concl 'xq)) q m)
                    (dk-cite! 'rr-abs-sub-sym gm gq)
                    (apply dk-ineq! (append base (list (list 'IN (list 'abs d1) 'RR) (list 'IN (list 'abs d2) 'RR) (list '= (list 'abs d1) (list 'abs d2))
                                                       (list '<= (list 'abs d2) (list '- (mrf-S 'xq q) (mrf-S 'xq m)))))))))))))))
(mrf-qed! 'bounded-partial-sums-cauchy)

;;; the pointwise lower limit, read at a point
(sp (make-wff '(FORALL omega (FORALL cF (FORALL x (IMPLIES (IN x omega)
   (== ((PTWISE-LIMINF omega cF) x) (ELIMINF (VNB-LAMBDA n_ NN ((cF n_) x))))))))))
(dk-peel!)
(mac 'PTWISE-LIMINF)
(if (not (dk-lam-b!)) (qrfl))
(if (mrf-open?) (qrfl))
(mrf-qed! 'ptwise-liminf-apply)

;;; at a point where g_k(x) is Cauchy, the lower limits of its parts are real and g_k(x) -> P(x) - N(x)
(define mrf-cP '(VNB-LAMBDA rpk_ NN (POS-PART omega (gs rpk_))))
(define mrf-cN '(VNB-LAMBDA rqk_ NN (NEG-PART omega (gs rqk_))))
(define mrf-PL (list 'PTWISE-LIMINF 'omega mrf-cP))
(define mrf-NL (list 'PTWISE-LIMINF 'omega mrf-cN))
(define mrf-gseq '(VNB-LAMBDA k NN ((gs k) xq)))
(sp (make-wff (mrf-alls '(omega gs xq) (mrf-imps (list '(IN gs (FUN NN (FUN omega RR))) '(IN xq omega) mrf-cauchy-g)
   (list 'AND (list 'IN (list mrf-PL 'xq) 'RR)
     (list 'AND (list 'IN (list mrf-NL 'xq) 'RR)
       (list 'CONVERGES-TO 'RR-MS mrf-gseq (list '- (list mrf-PL 'xq) (list mrf-NL 'xq)))))))))
(dk-peel!)
(fact 'nn-is-set) (fact 'rr-zero-in)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(define (mrf-part-lim! cS pf)          ; the sequence n |-> ((cS n) xq): typed, Cauchy, converges to its ELIMINF; returns (seq . limit)
  (let* ((sq (list 'VNB-LAMBDA 'n_ 'NN (list (list cS 'n_) 'xq)))
         (val (lambda (k) (list (list pf 'omega (list 'gs k)) 'xq)))
         (sq-at! (lambda (k)            ; (= (sq k) (val k)), val real nonneg
                   (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) k)
                   (dk-split-all! (list (dk-cite! 'part-values-at 'omega (list 'gs k) 'xq)))
                   (let ((pfk (list pf 'omega (list 'gs k))))
                     (dk-cite! (if (eq? pf 'POS-PART) 'pos-part-fun 'neg-part-fun) 'omega (list 'gs k))
                     (if (not (dk-asm? (list 'IN pfk 'SET))) (dk-have! (list 'IN pfk 'SET) (lambda () (dk-sethood! pfk)))))
                   (let ((e (list '= (list sq k) (val k))))
                     (if (not (dk-asm? e)) (dk-have! e (lambda () (mrf-beta!) (if (mrf-open?) (rfl)))))
                     (if (not (dk-asm? (list 'IN (list sq k) 'RR))) (dk-have! (list 'IN (list sq k) 'RR) (lambda () (subst e) (dk-ass!))))
                     (if (not (dk-asm? (list '<= 0 (list sq k)))) (dk-have! (list '<= 0 (list sq k)) (lambda () (subst e) (dk-ass!))))))))
    (dk-have! (list 'IN sq '(FUN NN RR))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (sq-at! k) (mrf-beta!) (dk-ass!))) (lambda () (dk-ass!)))))
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= 0 (list sq 'k))))
      (lambda () (let ((k (dk-di-var!))) (sq-at! k) (dk-ass!))))
    (let* ((cc (dk-cite! 'rr-cauchy-converges sq)) (hyp (cadr cc)))
      (dk-have! hyp
        (lambda ()
          (let* ((ld (begin (dk-peel!) (dk-asms))) (eps (cadr (mrf-pos-of ld))))
            (mrf-pos-parts! eps)
            (let* ((nb (dk-skolem! (dk-apply! (dk-ctx-form mrf-cauchy-g) eps) #t))
                   (cy (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f eps))) "the Cauchy tail")))
              (ew nb)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ld2 (dk-peel!))
                             (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld2))
                             (m (cadr (car ins))) (q (cadr (cadr ins))))
                        (sq-at! m) (sq-at! q)
                        (dk-apply! cy m q)
                        (mrf-gk! m 'xq) (mrf-gk! q 'xq)
                        (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) m)
                        (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) q)
                        (mrf-split! (dk-cite! 'parts-lipschitz 'omega (list 'gs m) (list 'gs q) 'xq))
                        (subst (list '= (list sq m) (val m)))
                        (subst (list '= (list sq q) (val q)))
                        (let* ((d (list '- (val m) (val q))) (dg (list '- (mrf-v m 'xq) (mrf-v q 'xq))))
                          (dk-type! d) (dk-type! dg) (dk-cite! 'rr-abs-closed d) (dk-cite! 'rr-abs-closed dg)
                          (dk-ineq! (list 'IN (list 'abs d) 'RR) (list 'IN (list 'abs dg) 'RR) (list 'IN eps 'RR)
                                    (list '<= (list 'abs d) (list 'abs dg)) (list '<= (list 'abs dg) eps)))))))))))
      (if (not (dk-asm? (caddr cc))) (detach! cc))
      (let* ((cv (dk-ctx-form (caddr cc)))
             (ex (dk-project! (list 'FORSOME 'L (list 'CONVERGES-TO 'RR-MS sq 'L)) 'CONVERGES cv))
             (l (dk-skolem! ex))
             (cvt (list 'CONVERGES-TO 'RR-MS sq l)))
        (dk-project! (list 'IN l '(PTS RR-MS)) 'converges-to cvt)
        (dk-rewrite-h! (list 'IN l '(PTS RR-MS)) '(PTS RR-MS) 'RR)
        (mrf-split! (dk-cite! 'rr-converges-nonneg-eliminf sq l))
        (cons sq l)))))
(let* ((pr (mrf-part-lim! mrf-cP 'POS-PART)) (nr (mrf-part-lim! mrf-cN 'NEG-PART))
       (ps (car pr)) (lp (cdr pr)) (ns (car nr)) (ln (cdr nr)))
  (dk-cite! 'ptwise-liminf-apply 'omega mrf-cP 'xq)
  (dk-cite! 'ptwise-liminf-apply 'omega mrf-cN 'xq)
  (dk-have! (list '= (list mrf-PL 'xq) lp) (lambda () (subst (list '== (list mrf-PL 'xq) (list 'ELIMINF ps))) (dk-ass!)))
  (dk-have! (list '= (list mrf-NL 'xq) ln) (lambda () (subst (list '== (list mrf-NL 'xq) (list 'ELIMINF ns))) (dk-ass!)))
  (dk-have! (list 'IN mrf-gseq '(FUN NN RR))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mrf-gk! k 'xq) (dk-ass!))) (lambda () (dk-ass!)))))
  (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list mrf-gseq 'j_) (list '- (list ps 'j_) (list ns 'j_)))))
    (lambda () (let ((k (dk-di-var!)))
                 (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) k)
                 (mrf-gk! k 'xq)
                 (dk-split-all! (list (dk-cite! 'part-values-at 'omega (list 'gs k) 'xq)))
                 (for-each (lambda (pf lm)
                             (let ((pfk (list pf 'omega (list 'gs k))))
                               (dk-cite! lm 'omega (list 'gs k))
                               (if (not (dk-asm? (list 'IN pfk 'SET))) (dk-have! (list 'IN pfk 'SET) (lambda () (dk-sethood! pfk))))))
                           '(POS-PART NEG-PART) '(pos-part-fun neg-part-fun))
                 (mrf-beta!)
                 (if (mrf-open?) (dk-ass!)))))
  (dk-cite! 'rr-limit-sub ps ns mrf-gseq lp ln)
  (subst (list '= (list mrf-PL 'xq) lp))
  (subst (list '= (list mrf-NL 'xq) ln))
  (dk-conj-close! (lambda () (dk-ass!))))
(mrf-qed! 'cauchy-point-limit)

;;; ===========================================================================
;;; (7) THE RAPID-SEQUENCE THEOREM: a sequence in L^p whose consecutive distances have bounded partial sums
;;;     converges in L^p to a measurable real function in L^p.
;;; ===========================================================================
(define (mrf-TRh h) (mrf-tree-sub 'h h mrf-TR))
(define mrf-TP (mrf-TRh mrf-PL))
(define mrf-TN (mrf-TRh mrf-NL))
(define mrf-fF (list 'VNB-LAMBDA 'sx_ 'omega (list '- (list mrf-TP 'sx_) (list mrf-TN 'sx_))))
(define mrf-Bh (list 'PTWISE-EPOW 'omega mrf-Hf '(recip p)))
(define mrf-Bt (mrf-TRh mrf-Bh))
(define mrf-ag0 '(ABS-FN omega (gs 0)))
(define mrf-gd (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list mrf-ag0 'sx_) (list mrf-Bt 'sx_))))
(define (mrf-off b P) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x b)) P))))
(define mrf-dom (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'nb (list 'AND '(IS-NULL-SET omega ca mu nb)
                   (mrf-off 'nb (list '<= '(abs ((gs k) x)) (list mrf-gd 'x))))))))
(define mrf-conv (list 'FORSOME 'nb (list 'AND '(IS-NULL-SET omega ca mu nb)
                   (mrf-off 'nb (list 'CONVERGES-TO 'RR-MS '(VNB-LAMBDA k NN ((gs k) x)) (list mrf-fF 'x))))))
(define (mrf-lpd h) (list 'LP-NORM 'omega 'ca 'mu 'p (list 'VNB-LAMBDA 'sx_ 'omega (list '- '((gs k) sx_) (list h 'sx_)))))
(define mrf-rconc
  (list 'FORSOME 'f (list 'AND '(IS-REAL-MEASURABLE-FN omega ca f)
    (list 'AND '(IN (LP-NORM omega ca mu p f) RR)
      (list 'ECONVERGES-TO (list 'VNB-LAMBDA 'k 'NN (mrf-lpd 'f)) 0)))))
(sp (make-wff (mrf-alls '(omega ca mu gs p rad cb) (mrf-imps (append mrf-H5 (list '(IN (LP-NORM omega ca mu p (gs 0)) RR))) mrf-rconc))))
(dk-peel!)
(mrf-setup!)
(mrf-recip-p!)
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(define mrf-bae (dk-cite! 'partial-sum-bounded-ae 'omega 'ca 'mu 'gs 'p 'rad 'cb))
(dk-split-all! (list mrf-bae))
(dk-project! (list 'IN mrf-Hf '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca mrf-Hf))
(define mrf-pw (caddr (caddr (caddr (caddr mrf-bae)))))
;; the parts, their lower limits, the limit function
(define (mrf-parts-seq! cS pf lm)      ; cS in FUN(NN, FUN(omega, RPS)), each term measurable
  (dk-have! (list 'IN cS '(FUN NN (FUN omega RR-POS-STAR)))
    (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!)))
                                          (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) n)
                                          (dk-cite! lm 'omega (list 'gs n)) (dk-ass!)))
                             (lambda () (dk-ass!)))))
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'ca (list cS 'n_))))
    (lambda () (let ((n (dk-di-var!)))
                 (dk-cite! 'fun-apply-type-c 'gs 'NN '(FUN omega RR) n)
                 (dk-cite! lm 'omega (list 'gs n))
                 (dk-apply! (dk-ctx-form mrf-gsm) n)
                 (dk-project! (list 'IS-MEASURABLE-FN 'omega 'ca (list pf 'omega (list 'gs n))) 'is-real-measurable-fn
                              (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (list 'gs n)))
                 (mrf-beta!)
                 (if (mrf-open?) (dk-ass!)))))
  (dk-cite! 'measurable-fn-liminf 'omega 'ca cS))
(mrf-parts-seq! mrf-cP 'POS-PART 'pos-part-fun)
(mrf-parts-seq! mrf-cN 'NEG-PART 'neg-part-fun)
(define mrf-fpP (dk-cite! 'finite-part-real-measurable 'omega 'ca mrf-PL))
(define mrf-fpN (dk-cite! 'finite-part-real-measurable 'omega 'ca mrf-NL))
(dk-split-all! (list mrf-fpP mrf-fpN))
(dk-cite! 'real-measurable-sub 'omega 'ca mrf-TP mrf-TN)
;; the dominating function
(dk-cite! 'measurable-fn-epow 'omega 'ca mrf-Hf '(recip p))
(define mrf-fpB (dk-cite! 'finite-part-real-measurable 'omega 'ca mrf-Bh))
(dk-split-all! (list mrf-fpB))
(dk-apply! (dk-ctx-form mrf-gsm) 0)
(dk-cite! 'abs-fn-real-measurable 'omega 'ca 'mu '(gs 0))
(dk-cite! 'real-measurable-add 'omega 'ca mrf-ag0 mrf-Bt)
(dk-project! (list 'IN mrf-Bt '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mrf-Bt))
(dk-project! '(IN (gs 0) (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca (gs 0)))
(dk-project! (list 'IN mrf-ag0 '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mrf-ag0))
;; values at a point
(define (mrf-H-at! x)                  ; x in omega: (IN (H x) RPS); returns (H x)
  (dk-cite! 'fun-apply-type-c mrf-Hf 'omega 'RR-POS-STAR x)
  (list mrf-Hf x))
(define (mrf-Bt-good! x)               ; x in omega, (H x) real: (= (Bt x) (EPOW (H x) (recip p))), real nonneg; returns it
  (let* ((hx (mrf-H-at! x)) (b (list 'EPOW hx '(recip p))))
    (dk-cite! 'rr-pos-star-nonneg hx)
    (mrf-split! (dk-apply! (dk-cite! 'epow-real-in hx) '(recip p)))
    (dk-cite! 'ptwise-epow-value 'omega mrf-Hf '(recip p) x)
    (dk-have! (list 'IN (list mrf-Bh x) 'RR) (lambda () (subst (list '= (list mrf-Bh x) b)) (dk-ass!)))
    (dk-apply! (dk-ctx-form (mrf-tree-sub 'h mrf-Bh mrf-tr-in)) x)
    (if (not (dk-asm? (list '= (list mrf-Bt x) b)))
        (dk-have! (list '= (list mrf-Bt x) b)
          (lambda () (subst (list '= (list mrf-Bt x) (list mrf-Bh x))) (subst (list '= (list mrf-Bh x) b)) (if (mrf-open?) (rfl)))))
    b))
;; LP(gd) is finite
(define mrf-aBt (list 'ABS-FN 'omega mrf-Bt))
(define mrf-pBt (list 'PTWISE-EPOW 'omega mrf-aBt 'p))
(dk-cite! 'abs-fn-fun 'omega mrf-Bt)
(mrf-split! (dk-cite! 'integral-abs-fn 'omega 'ca 'mu mrf-Bt))
(dk-cite! 'measurable-fn-epow 'omega 'ca mrf-aBt 'p)
(dk-have! (list 'PTWISE-LE 'omega mrf-pBt mrf-Hf)
  (lambda ()
    (mac 'PTWISE-LE)
    (let* ((x (dk-di-var!)) (hx (mrf-H-at! x)))
      (dk-cite! 'fun-apply-type-c mrf-Bt 'omega 'RR x)
      (dk-cite! 'abs-fn-value 'omega mrf-Bt x)
      (dk-cite! 'rr-abs-closed (list mrf-Bt x)) (dk-cite! 'rr-abs-nonneg (list mrf-Bt x))
      (mrf-rps! (list 'abs (list mrf-Bt x)))
      (dk-cite! 'ptwise-epow-value 'omega mrf-aBt 'p x)
      (subst (list '= (list mrf-pBt x) (list 'EPOW (list mrf-aBt x) 'p)))
      (subst (list '== (list mrf-aBt x) (list 'abs (list mrf-Bt x))))
      (use-em (list 'IN hx 'RR)
        (lambda ()
          (let ((b (mrf-Bt-good! x)))
            (mrf-rps! b)
            (dk-cite! 'rr-abs-of-nonneg b)
            (mrf-split! (dk-cite! 'epow-inverse hx 'p))
            (subst (list '= (list mrf-Bt x) b))
            (subst (list '= (list 'abs b) b))
            (subst (list '= (list 'EPOW b 'p) hx))
            (dk-cite! 'rr-pos-star-le-refl hx)
            (dk-ass!)))
        (lambda ()
          (mrf-rps-case! hx)
          (dk-cite! 'epow-pos-inf '(recip p))
