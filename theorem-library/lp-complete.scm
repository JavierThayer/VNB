                        (subst (list '= (list (mrf-En n) x) (list 'EPOW (list ad x) 'p)))
                        (subst (list '== (list ad x) (list 'abs (list (mrf-dsum n) x))))
                        (subst (list '= (list (mrf-dsum n) x) s))
                        (subst (list '= (list 'abs s) s))
