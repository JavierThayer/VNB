;; THE RIESZ-FISCHER THEOREM (L^p is complete), on functions: a Cauchy sequence for the L^p seminorm has an
;; L^p limit, a measurable real function f with ||f_k - f||_p -> 0.
(define (mrf-fd a b) (list 'VNB-LAMBDA 'sx_ 'omega (list '- (list a 'sx_) (list b 'sx_))))
(define (mrf-tail nt e)
  (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'q (list 'IMPLIES '(IN q NN)
    (list 'IMPLIES (list '<= nt 'm) (list 'IMPLIES (list '<= nt 'q)
      (list '<= (mrf-LP (mrf-fd '(fs m) '(fs q))) e))))))))
(define mrf-fcauchy (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN) (mrf-tail 'nb 'eps))))))
(define mrf-fsm '(FORALL k (IMPLIES (IN k NN) (IS-REAL-MEASURABLE-FN omega ca (fs k)))))
(define mrf-fsl '(FORALL k (IMPLIES (IN k NN) (IN (LP-NORM omega ca mu p (fs k)) RR))))
(define mrf-lpconc
  (list 'FORSOME 'f (list 'AND '(IS-REAL-MEASURABLE-FN omega ca f)
    (list 'AND '(IN (LP-NORM omega ca mu p f) RR)
      (list 'ECONVERGES-TO (list 'VNB-LAMBDA 'k 'NN (mrf-LP (mrf-fd '(fs k) 'f))) 0)))))
(sp (make-wff (mrf-alls '(omega ca mu p fs) (mrf-imps (list '(IS-MEASURE omega ca mu) '(IN p RR) '(<= 1 p) '(IN fs (FUN NN (FUN omega RR)))
                                                          mrf-fsm mrf-fsl mrf-fcauchy)
   mrf-lpconc))))
(dk-peel!)
(mrf-setup!)
(mrf-recip-p!)
(define mrf-hg (dk-cite! 'half-geometric-facts))
(dk-split-all! (list mrf-hg))
(define (mrf-fk! k)                    ; fs k: typing, measurable, finite norm
  (dk-cite! 'fun-apply-type-c 'fs 'NN '(FUN omega RR) k)
  (dk-apply! (dk-ctx-form mrf-fsm) k)
  (dk-apply! (dk-ctx-form mrf-fsl) k))
(define (mrf-radk! k)                  ; (= (rad k) (r k)), r k real, positive, POS-RR
  (dk-split! (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'AND (list '= (list mrf-rad 'k) (mrf-r 'k)) (list '< 0 (mrf-r 'k)))))) k))
  (dk-cite! 'power-real-closed 1/2 k)
  (mrf-posrr! (mrf-r k)))
;; choose indices: g(k) >= k with the tail from g(k) on rad(k)-small
(define mrf-fam (list 'VNB-LAMBDA 'rck_ 'NN (list 'SEP 'nq_ 'NN (list 'AND '(<= rck_ nq_) (mrf-tail 'nq_ (mrf-r 'rck_))))))
(define (mrf-famk k) (list 'SEP 'nq_ 'NN (list 'AND (list '<= k 'nq_) (mrf-tail 'nq_ (mrf-r k)))))
(define (mrf-fam-at! k)                ; (= (fam k) (famk k))
  (let ((e (list '= (list mrf-fam k) (mrf-famk k))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda ()
                      (dk-have! (list 'IN (mrf-famk k) 'SET) (lambda () (dk-sethood! (mrf-famk k))))
                      (mrf-beta!) (if (mrf-open?) (rfl)))))
    e))
(define mrf-ch (dk-fact! 'rmm-nn-choice 'NN mrf-fam))
(dk-have! (cadr mrf-ch)
  (lambda ()
    (let* ((k (dk-di-var!)))
      (mrf-radk! k)
      (let* ((nb (dk-skolem! (dk-apply! (dk-ctx-form mrf-fcauchy) (mrf-r k)) #t))
             (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb))) "the Cauchy tail"))
             (w (list '+ nb k)))
        (mrf-and! (list 'IN nb 'NN) (list 'IN k 'NN))
        (dk-cite! 'nn-add-closed nb k)
        (dk-cite! 'nn-in-rr nb) (dk-cite! 'nn-in-rr k)
        (ew w)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (mrf-fam-at! k)
                  (subst (mrf-fam-at! k))
                  (in-sep! (lambda () (dk-ass!))
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (if (not (dk-ass!))
                              (if (dk-head-is? (dk-goal) '<=)
                                  (begin (dk-cite! 'nn-zero-le nb) (dk-ineq! (list 'IN nb 'RR) (list 'IN k 'RR) (list '<= 0 nb)))
                                  (let* ((ld (dk-peel!))
                                         (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld))
                                         (m (cadr (car ins))) (q (cadr (cadr ins))))
                                    (dk-cite! 'nn-in-rr m) (dk-cite! 'nn-in-rr q) (dk-cite! 'nn-zero-le k)
                                    (dk-have! (list '<= nb m) (lambda () (dk-ineq! (list 'IN nb 'RR) (list 'IN k 'RR) (list 'IN m 'RR) (list '<= 0 k) (list '<= w m))))
                                    (dk-have! (list '<= nb q) (lambda () (dk-ineq! (list 'IN nb 'RR) (list 'IN k 'RR) (list 'IN q 'RR) (list '<= 0 k) (list '<= w q))))
                                    (dk-apply! tl m q)
                                    (dk-ass!))))))))))))))))
(detach! mrf-ch)
(define mrf-g (dk-skolem! (caddr mrf-ch) #t))
(define mrf-gk-form (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mrf-g))) "the choice property"))
(define (mrf-gpick! k)                 ; k <= g k and the tail from g k at r k; g k in NN
  (dk-cite! 'fun-apply-type-c mrf-g 'NN 'NN k)
  (let ((m (dk-apply! mrf-gk-form k)))
    (mrf-fam-at! k)
    (let ((m2 (dk-rewrite-h! m (list mrf-fam k) (mrf-famk k))))
      (sep-me (dk-ctx-form (list 'IN (list mrf-g k) (mrf-famk k))))
      (dk-split-all!))))
;; the subsequence
(define mrf-gsq (list 'VNB-LAMBDA 'rgk_ 'NN (list 'fs (list mrf-g 'rgk_))))
(define (mrf-gs-at! k)                 ; (= (gs k) (fs (g k)))
  (dk-cite! 'fun-apply-type-c mrf-g 'NN 'NN k)
  (mrf-fk! (list mrf-g k))
  (let ((e (list '= (list mrf-gsq k) (list 'fs (list mrf-g k)))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mrf-beta!) (if (mrf-open?) (rfl)))))
    e))
(dk-have! (list 'IN mrf-gsq '(FUN NN (FUN omega RR)))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (dk-cite! 'fun-apply-type-c mrf-g 'NN 'NN k) (mrf-fk! (list mrf-g k)) (dk-ass!))) (lambda () (dk-ass!)))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (list mrf-gsq 'k))))
  (lambda () (let ((k (dk-di-var!))) (subst (mrf-gs-at! k)) (dk-ass!))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (mrf-LP (mrf-tree-sub 'gs mrf-gsq (mrf-dif 'k))) (list mrf-rad 'k))))
  (lambda ()
    (let* ((k (dk-di-var!)) (sk (list 'succ k)) (gk (list mrf-g k)) (gsk (list mrf-g sk)))
      (fact 'nn-succ-closed k)
      (mrf-radk! k) (mrf-radk! sk)
      (dk-cite! 'fun-apply-type-c mrf-g 'NN 'NN sk)
      (subst (mrf-gs-at! k)) (subst (mrf-gs-at! sk))
      (subst (list '= (list mrf-rad k) (mrf-r k)))
      (mrf-gpick! k) (mrf-gpick! sk)
      (dk-cite! 'nn-in-rr gk) (dk-cite! 'nn-in-rr gsk)
      (dk-cite! 'nn-le-refl gk) (dk-cite! 'nn-le-refl gsk)
      (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (mrf-r '(succ k)) (mrf-r 'k))))) k)
      (let ((lp (mrf-LP (mrf-fd (list 'fs gsk) (list 'fs gk)))))
        (use-em (list '<= gk gsk)
          (lambda ()
            (dk-apply! (dk-ctx-form (mrf-tail gk (mrf-r k))) gsk gk)
            (dk-ass!))
          (lambda ()
            (dk-cite! 'rr-not-le-lt gk gsk)
            (dk-have! (list '<= gsk gk) (lambda () (dk-ineq! (list 'IN gk 'RR) (list 'IN gsk 'RR) (list '< gsk gk))))
            (dk-apply! (dk-ctx-form (mrf-tail gsk (mrf-r sk))) gsk gk)
            (dk-cite! 'real-measurable-sub 'omega 'ca (list 'fs gsk) (list 'fs gk))
            (mrf-lp-rps! (mrf-fd (list 'fs gsk) (list 'fs gk)))
            (mrf-real-of-le! lp (mrf-r sk))
            (dk-ineq! (list 'IN lp 'RR) (list 'IN (mrf-r k) 'RR) (list 'IN (mrf-r sk) 'RR)
                      (list '<= lp (mrf-r sk)) (list '<= (mrf-r sk) (mrf-r k)))))))))
(dk-have! (list 'IN (mrf-LP (list mrf-gsq 0)) 'RR) (lambda () (fact 'nn-zero-in) (subst (mrf-gs-at! 0)) (dk-ass!)))
(define mrf-rp (dk-cite! 'lp-rapid-sequence-converges 'omega 'ca 'mu mrf-gsq 'p mrf-rad 2))
(define mrf-f (dk-skolem! mrf-rp #t))
;; the whole sequence converges
(define (mrf-ak f k) (mrf-LP (mrf-fd (list 'fs k) f)))
(define mrf-aq (list 'VNB-LAMBDA 'k 'NN (mrf-ak mrf-f 'k)))
(define (mrf-aqk! k)                    ; a k real nonneg, (= (aq k) (LP ..)); returns the LP
  (mrf-fk! k)
  (let ((t (mrf-ak mrf-f k)))
    (mrf-split! (dk-cite! 'lp-norm-sub-le 'omega 'ca 'mu 'p (list 'fs k) mrf-f))
    (dk-cite! 'real-measurable-sub 'omega 'ca (list 'fs k) mrf-f)
    (mrf-lp-rps! (mrf-fd (list 'fs k) mrf-f))
    (dk-cite! 'rr-pos-star-nonneg t)
    (let ((e (list '= (list mrf-aq k) t)))
      (if (not (dk-asm? e)) (dk-have! e (lambda () (mrf-beta!) (if (mrf-open?) (rfl))))))
    t))
(dk-have! (list 'IN mrf-aq '(FUN NN RR))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mrf-aqk! k) (dk-ass!))) (lambda () (dk-ass!)))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= 0 (list mrf-aq 'k))))
  (lambda () (let ((k (dk-di-var!))) (mrf-aqk! k) (subst (list '= (list mrf-aq k) (mrf-ak mrf-f k))) (dk-ass!))))
(define mrf-bq (list 'VNB-LAMBDA 'k 'NN (mrf-LP (mrf-fd (list mrf-gsq 'k) mrf-f))))
(define (mrf-bqk! j)                    ; (= (bq j) LP(fs(g j) - f)), real nonneg; returns the LP
  (mrf-gs-at! j)
  (let ((t (mrf-ak mrf-f (list mrf-g j))))
    (mrf-aqk! (list mrf-g j))
    (let ((e (list '= (list mrf-bq j) t)))
      (if (not (dk-asm? e)) (dk-have! e (lambda () (mrf-beta!) (if (mrf-open?) (rfl))))))
    t))
;; b_j = ||f_{g(j)} - f||_p -> 0, eventually below h
(define mrf-rpc (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f mrf-f))) (dk-asms)))
(if mrf-rpc (dk-split-all! (list mrf-rpc)))
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list 'IN (list mrf-bq 'cpsk_) 'RR)))
  (lambda () (let ((j (dk-di-var!))) (mrf-bqk! j) (mrf-beta!) (if (mrf-open?) (dk-ass!)))))
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list mrf-bq 'cpsk_))))
  (lambda () (let ((j (dk-di-var!))) (mrf-bqk! j) (mrf-beta!) (if (mrf-open?) (dk-ass!)))))
(dk-project! (list '= (list 'ELIMSUP mrf-bq) 0) 'econverges-to (list 'ECONVERGES-TO mrf-bq 0))
(define mrf-asmall (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
                      (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(<= nb k) (list '<= (list mrf-aq 'k) 'r)))))))))
(dk-have! mrf-asmall
  (lambda ()
    (let* ((ld (dk-peel!)) (r (cadr (mrf-pos-of ld))) (h (list '* 1/2 r)))
      (mrf-pos-parts! r)
      (dk-have! (list 'IN h 'RR) (lambda () (dk-type! h)))
      (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list 'IN r 'RR) (list '< 0 r))))
      (mrf-posrr! h)
      (let* ((n1 (dk-skolem! (dk-apply! (dk-ctx-form mrf-fcauchy) h) #t))
             (tl1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n1) (dk-contains? f h))) "the Cauchy tail")))
        (dk-have! (list '< (list 'ELIMSUP mrf-bq) h) (lambda () (subst (list '= (list 'ELIMSUP mrf-bq) 0)) (dk-ass!)))
        (let* ((ev (dk-apply! (dk-cite! 'elimsup-eventually-below mrf-bq) h))
               (n2 (dk-skolem! ev #t))
               (tl2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n2) (dk-contains? f h))) "the tail of b"))
               (j (list '+ n1 n2)) (gj (list mrf-g j)))
          (mrf-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
          (dk-cite! 'nn-add-closed n1 n2)
          (dk-cite! 'nn-in-rr n1) (dk-cite! 'nn-in-rr n2)
          (mrf-gpick! j)
          (dk-cite! 'nn-in-rr gj)
          (dk-have! (list '<= n2 j) (lambda () (dk-cite! 'nn-zero-le n1) (dk-ineq! (list 'IN n1 'RR) (list 'IN n2 'RR) (list '<= 0 n1))))
          (dk-apply! tl2 j)
          (let ((bj (mrf-bqk! j)))
            (dk-have! (list '< bj h) (lambda () (subst (list '= bj (list mrf-bq j))) (dk-ass!)))
            (ew n1)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((ld2 (dk-peel!)) (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld2)))
                           (f1 (mrf-fd (list 'fs k) (list 'fs gj))) (f2 (mrf-fd (list 'fs gj) mrf-f))
                           (sm (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list f1 'sx_) (list f2 'sx_))))
                           (ak (mrf-aqk! k)))
                      (dk-cite! 'nn-in-rr k)
                      (dk-cite! 'nn-zero-le n2)
                      (dk-have! (list '<= n1 gj) (lambda () (dk-ineq! (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN gj 'RR) (list '<= 0 n2) (list '<= j gj))))
                      (dk-apply! tl1 k gj)
                      (mrf-fk! gj)
                      (dk-cite! 'real-measurable-sub 'omega 'ca (list 'fs k) (list 'fs gj))
                      (dk-cite! 'real-measurable-sub 'omega 'ca (list 'fs gj) mrf-f)
                      (dk-project! (list 'IN mrf-f '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mrf-f))
                      (dk-have! (list 'IN sm '(FUN omega RR))
                        (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                                              (dk-cite! 'fun-apply-type-c (list 'fs k) 'omega 'RR x) (dk-cite! 'fun-apply-type-c (list 'fs gj) 'omega 'RR x)
                                                              (dk-cite! 'fun-apply-type-c mrf-f 'omega 'RR x)
                                                              (mrf-beta!) (dk-type! (cadr (dk-goal))) (dk-ass!)))
                                                 (lambda () (dk-ass!)))))
                      (dk-project! (list 'IN (mrf-fd (list 'fs k) mrf-f) '(FUN omega RR)) 'is-real-measurable-fn
                                   (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (mrf-fd (list 'fs k) mrf-f)))
                      (mrf-funext! sm (mrf-fd (list 'fs k) mrf-f) 'RR 'RR
                        (lambda (x) (dk-cite! 'fun-apply-type-c (list 'fs k) 'omega 'RR x) (dk-cite! 'fun-apply-type-c (list 'fs gj) 'omega 'RR x)
                                    (dk-cite! 'fun-apply-type-c mrf-f 'omega 'RR x)
                                    (mrf-beta!) (if (mrf-open?) (crs))))
                      (let* ((tri (dk-cite! 'lp-norm-triangle 'omega 'ca 'mu 'p f1 f2))
                             (l1 (mrf-LP f1)) (l2 (mrf-LP f2)))
                        (dk-rewrite-h! tri sm (mrf-fd (list 'fs k) mrf-f))
                        (mrf-lp-rps! f1)
                        (mrf-real-of-le! l1 h)
                        (dk-cite! 'rr-pos-star-nonneg l2)
                        (dk-cite! 'eplus-real-defined l1 l2)
                        (dk-cite! 'binplus-apply l1 l2)
                        (dk-rewrite-h! (dk-ctx-form (list '<= ak (list 'eplus l1 l2))) (list 'eplus l1 l2) (list 'binplus l1 l2))
                        (dk-rewrite-h! (dk-ctx-form (list '<= ak (list 'binplus l1 l2))) (list 'binplus l1 l2) (list '+ l1 l2))
                        (subst (list '= (list mrf-aq k) ak))
                        (dk-ineq! (list 'IN ak 'RR) (list 'IN l1 'RR) (list 'IN l2 'RR) (list 'IN h 'RR) (list 'IN r 'RR)
                                  (list '<= ak (list '+ l1 l2)) (list '<= l1 h) (list '< l2 h)))))))))))))
(dk-cite! 'econverges-of-eventually-small mrf-aq)
(ew mrf-f)
(dk-conj-close! (lambda () (dk-ass!)))
(mrf-qed! 'lp-complete)
